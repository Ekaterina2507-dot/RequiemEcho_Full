s","start":128,"end":162,"leftHand":{"type":"functionArgs","context":["console","log",0]}}],[{"attachment":"scriptCommand/17895121634068536.js","start":222,"end":244,"leftHand":{"type":"functionArgs","context":["console","error",0]}}],null,null,[{"headerIndex":15,"headerParam":["",0,0,2,""]}],[{"headerIndex":17,"headerParam":["",0,0,2,"Khywae"],"rowInfoText":"Khywae"}],[{"headerIndex":19,"headerParam":["",0,0,2,"Khywae"],"rowInfoText":"Khywae"}]],"indexIds":{"LAYER_S 1 boat 0 0 255 0 0 0 0\nLAYER_S 2 foreground 0 0 255 5 0 0 0\nLAYER_S 3 temple 140 147 255 4 0 0 0\nLAYER_S 4 mastro 576 0 255 0 0 0 0\nLAYER_S 5 railing_top 480 220 255 4 0 0 0\nLAYER_S 6 railing_under 480 220 255 0 0 0 0\nLAYER_S 7 cauldron 1110 277 255 0 0 0 0\nLAYER_S 8 mastrotop 576 0 255 4 0 0 0\n":0,"Lou":1,"The little dog wags his tail and barks at you as if in greeting.":2,"Woof! Woof!":3,"I want to join the crew":4,"View travel logs (khywae's Carrd)":5,"Nevermind":6,"https://patreon.com/khywae":7,"Woof!":8,"https://khywae.carrd.co/":9,"Transfer (Temple)":10,"Transfer (TVRoom)":11,"khy_full":12,"You return the VHS to her, and she smiles at you.":13,"Khywae":14,"Thanks! How was it? I hope you enjoyed the tape. We tried some different ingredients this time.":15,"What are these tapes?":16,"They allow us to connect to AUs aka Alternate Universes.":17,"They're made with ingredients we gather on our travels. Like Slow Burn Embers and Cliché Caramel.":18,"Which ingredients are using for the next tape?":19,"I’m not sure yet. The crew members will be meeting soon to decide. ":20,"Voting always happens at the beginning of the month, so remember to vote!":21,"The travel logs will be updated once a decision is made.":22,"That's all for now.":23,"Sure thing, darling. If you need anything, you know where to find me.":24,"Thank you for being on this journey with us!":25,"Remember to talk to Lou. He's waiting for you.":26,"EV008":27,"The tape inside the cauldron is blank, its surface shimmering with an almost ethereal glow, as if it is pulsing with anticipation.":28,"EV009":29,"A potions book lies open on an incomplete recipe:":30,"2 Teardrops of Forbidden Love, A Strand of Enemies-to-Lovers Thread, 3 Drops of Mutual Pining Essence, 1 Sprig of Miscommunication Herb":31,"At the bottom of the page, a handwritten note adds: ‘Warning: Handle with care! May cause extreme slow burns.'":32,"EV010":33,"A box filled with blank VHS tapes.":34,"EV011":35,"EV012":36,"EV013":37,"A small collection of potions. Some of the labels say 'Slow Burn Embers', 'Adversary's Amorous Essence', 'Bondage Balm', 'Werewolf Pheromones'... Maybe it's better if you stop reading.":38,"EV014":39,"A small collection of potions. Some of the labels say ‘Cliché Caramel', ‘Shipper's Squeal Serum’, 'Bodice-Ripper Blossom', ‘Yielding Male Bark'... Maybe it's better if you stop reading.":40,"EV015":41,"A small collection of potions. Some of the labels say ‘Plot Twist Essence’, ‘Mary Sue Sparkle', 'Domineering Draught’, ‘Pegging Pepper Extract’... Maybe it's better if you stop reading.":42,"EV016":43,"<WordWrap>Someone hastily carved something on the wood. It says 'I love muscles'. Wow.":44,"Someone must really love muscles.":45,"INTRO":46,"Game saved successfully in slot ":47,"Failed to save game:":48,"khywae's boat":49,"save_boat":50,"Someone is humming a spooky tune.":51,"Oh hey, you're back!":52,"Come, let’s have a talk.":53},"extension":"json","dataType":"map","filename":"Map001","basename":"Map001.json","path":"data/Map001.json","relPath":"data/Map001.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":true,"progress":{"translated":0,"length":54,"percent":0},"cacheResetOnChange":{},"cellInfo":[[null,{"v":1,"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU","v":1},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"v":1,"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU","v":1},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"v":1,"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{"t":"HU"},{"t":"HU"},{"t":"HU"},{"t":"HU"}],[null,{},{},{},{}]],"lastSelectedCell":[23,1]},"data/Map004.json":{"data":[["ch 1 Final Hunt","ch 1 Финальная охота","ch 1 Финальная охота","ch 1 Финальная охота","ch 1 Финальная охота"],["pls_open","pls_open","pls_open","pls_open","pls_open"],["Game saved successfully in slot ","Игра успешно сохранена в слот ","Игра успешно сохранена в слот ","Игра успешно сохранена в слот ","Игра успешно сохранена в слот "],["Failed to save game:","Не удалось сохранить игру:","Не удалось сохранить игру:","Не удалось сохранить игру:","Не удалось сохранить игру:"],["Chapter 1 : The Final Hunt","Глава 1: Финальная охота","Глава 1: Финальная охота","Глава 1: Финальная охота","Глава 1: Финальная охота"],["forest_fire","forest_fire","forest_fire","forest_fire","forest_fire"],["You step out of the worn-out house, the door creaking behind you as it swings shut.","Ты выходишь из ветхого дома, и дверь со скрипом захлопывается у тебя за спиной.","Ты выходишь из ветхого дома, и дверь со скрипом захлопывается у тебя за спиной.","Ты выходишь из ветхого дома, и дверь со скрипом захлопывается у тебя за спиной.","Ты выходишь из ветхого дома, и дверь со скрипом захлопывается у тебя за спиной."],["The weight of your gear drags at your body, but it’s not just the equipment — it’s the years.","Снаряжение оттягивает плечи, но давит не только оно — давят годы.","Снаряжение оттягивает плечи, но давит не только оно — давят годы.","Снаряжение оттягивает плечи, но давит не только оно — давят годы.","Снаряжение оттягивает плечи, но давит не только оно — давят годы."],["You’ve been preparing for this night longer than you care to admit. Every step feels heavy.","Ты готовилась к этой ночи дольше, чем готова признать. Каждый шаг даётся тяжело.","Ты готовилась к этой ночи дольше, чем готова признать. Каждый шаг даётся тяжело.","Ты готовилась к этой ночи дольше, чем готова признать. Каждый шаг даётся тяжело.","Ты готовилась к этой ночи дольше, чем готова признать. Каждый шаг даётся тяжело."],["But you can’t stop. Not now.","Но останавливаться нельзя. Только не сейчас.","Но останавливаться нельзя. Только не сейчас.","Но останавливаться нельзя. Только не сейчас.","Но останавливаться нельзя. Только не сейчас."],["Your gaze lingers on the windows. Inside, the shadows of your old life remain — a life that feels like a ghost now.","Твой взгляд задерживается на окнах. Внутри остались тени прежней жизни — теперь она кажется призраком.","Твой взгляд задерживается на окнах. Внутри остались тени прежней жизни — теперь она кажется призраком.","Твой взгляд задерживается на окнах. Внутри остались тени прежней жизни — теперь она кажется призраком.","Твой взгляд задерживается на окнах. Внутри остались тени прежней жизни — теперь она кажется призраком."],["Photographs on the walls, dust-covered remnants of forgotten hobbies. There was a time when you had dreams — other dreams. ","Фотографии на стенах, покрытые пылью следы забытых увлечений. Когда-то у тебя были другие мечты.","Фотографии на стенах, покрытые пылью следы забытых увлечений. Когда-то у тебя были другие мечты.","Фотографии на стенах, покрытые пылью следы забытых увлечений. Когда-то у тебя были другие мечты.","Фотографии на стенах, покрытые пылью следы забытых увлечений. Когда-то у тебя были другие мечты."],["But they’ve long since crumbled, replaced by a singular, consuming purpose: hunting.","Но они давно рассыпались в прах, уступив место единственной, всепоглощающей цели: охоте.","Но они давно рассыпались в прах, уступив место единственной, всепоглощающей цели: охоте.","Но они давно рассыпались в прах, уступив место единственной, всепоглощающей цели: охоте.","Но они давно рассыпались в прах, уступив место единственной, всепоглощающей цели: охоте."],["You hear it.","Ты слышишь это.","Ты слышишь это.","Ты слышишь это.","Ты слышишь это."],["Birds flapping in a hurried ascent. You know what that means. ","Птицы торопливо взмывают в небо. Ты знаешь, что это значит.","Птицы торопливо взмывают в небо. Ты знаешь, что это значит.","Птицы торопливо взмывают в небо. Ты знаешь, что это значит.","Птицы торопливо взмывают в небо. Ты знаешь, что это значит."],["Sunset is close.","Скоро закат.","Скоро закат.","Скоро закат.","Скоро закат."],["It's time.","Пора.","Пора.","Пора.","Пора."],["The bonfire pierces the encroaching darkness, a lone beacon amidst the towering trees. ","Костёр прорезает сгущающуюся тьму — одинокий маяк среди высоких деревьев.","Костёр прорезает сгущающуюся тьму — одинокий маяк среди высоких деревьев.","Костёр прорезает сгущающуюся тьму — одинокий маяк среди высоких деревьев.","Костёр прорезает сгущающуюся тьму — одинокий маяк среди высоких деревьев."],["You finish threading the barbed wire from tree to tree, building a harsh perimeter around the clearing — a trap with no escape. ","Ты заканчиваешь натягивать колючую проволоку от дерева к дереву, замыкая вокруг поляны жестокий периметр — ловушку, из которой нет выхода.","Ты заканчиваешь натягивать колючую проволоку от дерева к дереву, замыкая вокруг поляны жестокий периметр — ловушку, из которой нет выхода.","Ты заканчиваешь натягивать колючую проволоку от дерева к дереву, замыкая вокруг поляны жестокий периметр — ловушку, из которой нет выхода.","Ты заканчиваешь натягивать колючую проволоку от дерева к дереву, замыкая вокруг поляны жестокий периметр — ловушку, из которой нет выхода."],["Your gaze drifts toward the horizon as the sun sinks lower, disappearing behind the trees, casting long shadows that stretch like dark fingers clawing at the ground. ","Ты смотришь на горизонт: солнце опускается всё ниже и скрывается за деревьями, а длинные тени тянутся по земле, словно тёмные пальцы, вцепляющиеся в неё.","Ты смотришь на горизонт: солнце опускается всё ниже и скрывается за деревьями, а длинные тени тянутся по земле, словно тёмные пальцы, вцепляющиеся в неё.","Ты смотришь на горизонт: солнце опускается всё ниже и скрывается за деревьями, а длинные тени тянутся по земле, словно тёмные пальцы, вцепляющиеся в неё.","Ты смотришь на горизонт: солнце опускается всё ниже и скрывается за деревьями, а длинные тени тянутся по земле, словно тёмные пальцы, вцепляющиеся в неё."],["You need to be fast. They’ll come soon.","Нужно торопиться. Они скоро придут.","Нужно торопиться. Они скоро придут.","Нужно торопиться. Они скоро придут.","Нужно торопиться. Они скоро придут."],["Put tripwires outside the clearing as well","Расставить растяжки и за пределами поляны","Расставить растяжки и за пределами поляны","Расставить растяжки и за пределами поляны","Расставить растяжки и за пределами поляны"],["Put tripwires only inside the clearing","Расставить растяжки только внутри поляны","Расставить растяжки только внутри поляны","Расставить растяжки только внутри поляны","Расставить растяжки только внутри поляны"],["You extend the explosives beyond the clearing, placing tripwires along the outer perimeter. If any of them manage to slip past the first line of defense, these will catch them.","Ты выносишь взрывчатку за пределы поляны, протягивая растяжки по внешнему периметру. Если кто-то из них прорвётся через первую линию обороны, эти ловушки его остановят.","Ты выносишь взрывчатку за пределы поляны, протягивая растяжки по внешнему периметру. Если кто-то из них прорвётся через первую линию обороны, эти ловушки его остановят.","Ты выносишь взрывчатку за пределы поляны, протягивая растяжки по внешнему периметру. Если кто-то из них прорвётся через первую линию обороны, эти ловушки его остановят.","Ты выносишь взрывчатку за пределы поляны, протягивая растяжки по внешнему периметру. Если кто-то из них прорвётся через первую линию обороны, эти ловушки его остановят."],["Tonight, there’s no escape.","Сегодня им не уйти.","Сегодня им не уйти.","Сегодня им не уйти.","Сегодня им не уйти."],["They’ll be drawn to the bonfire like moths to a flame. Concentrating the explosives within the clearing will ensure they’re right where you want them when the trap springs. ","Костёр притянет их, как мотыльков на огонь. Если сосредоточить взрывчатку внутри поляны, они окажутся именно там, где тебе нужно, когда ловушка захлопнется.","Костёр притянет их, как мотыльков на огонь. Если сосредоточить взрывчатку внутри поляны, они окажутся именно там, где тебе нужно, когда ловушка захлопнется.","Костёр притянет их, как мотыльков на огонь. Если сосредоточить взрывчатку внутри поляны, они окажутся именно там, где тебе нужно, когда ловушка захлопнется.","Костёр притянет их, как мотыльков на огонь. Если сосредоточить взрывчатку внутри поляны, они окажутся именно там, где тебе нужно, когда ловушка захлопнется."],["The forest deepens into shadow as you finish setting the tripwires. You nod, satisfied — but there’s one last step.","Лес погружается в тень, пока ты заканчиваешь с растяжками. Ты удовлетворённо киваешь, но остаётся последний штрих.","Лес погружается в тень, пока ты заканчиваешь с растяжками. Ты удовлетворённо киваешь, но остаётся последний штрих.","Лес погружается в тень, пока ты заканчиваешь с растяжками. Ты удовлетворённо киваешь, но остаётся последний штрих.","Лес погружается в тень, пока ты заканчиваешь с растяжками. Ты удовлетворённо киваешь, но остаётся последний штрих."],["Pulling out a knife, you make a swift cut across your palm, letting your blood drip onto the soil. It’s dark, almost black in the fading light, and the ground drinks it up, vanishing as quickly as it falls.","Достав нож, ты резким движением рассекаешь ладонь, и кровь капает на землю. В меркнущем свете она кажется тёмной, почти чёрной; почва жадно впитывает её, стоит ей упасть.","Достав нож, ты резким движением рассекаешь ладонь, и кровь капает на землю. В меркнущем свете она кажется тёмной, почти чёрной; почва жадно впитывает её, стоит ей упасть.","Достав нож, ты резким движением рассекаешь ладонь, и кровь капает на землю. В меркнущем свете она кажется тёмной, почти чёрной; почва жадно впитывает её, стоит ей упасть.","Достав нож, ты резким движением рассекаешь ладонь, и кровь капает на землю. В меркнущем свете она кажется тёмной, почти чёрной; почва жадно впитывает её, стоит ей упасть."],["You wrap the wound with a strip of cloth, tightening it until the pain is just a dull throb.","Ты перевязываешь рану полоской ткани и затягиваешь потуже, пока боль не превращается в глухую пульсацию.","Ты перевязываешь рану полоской ткани и затягиваешь потуже, пока боль не превращается в глухую пульсацию.","Ты перевязываешь рану полоской ткани и затягиваешь потуже, пока боль не превращается в глухую пульсацию.","Ты перевязываешь рану полоской ткани и затягиваешь потуже, пока боль не превращается в глухую пульсацию."],["You don’t usually do this. They’re already drawn to the living.","Обычно ты так не делаешь. Живые и без того притягивают их.","Обычно ты так не делаешь. Живые и без того притягивают их.","Обычно ты так не делаешь. Живые и без того притягивают их.","Обычно ты так не делаешь. Живые и без того притягивают их."],["But today is different. You need all of them to come.","Но сегодня всё иначе. Тебе нужно, чтобы пришли все до единого.","Но сегодня всё иначе. Тебе нужно, чтобы пришли все до единого.","Но сегодня всё иначе. Тебе нужно, чтобы пришли все до единого.","Но сегодня всё иначе. Тебе нужно, чтобы пришли все до единого."],["You’ve tried tracking them to their lairs before, but the tunnels are too winding, too deep, too impossible to navigate. ","Раньше ты пыталась выследить их до логова, но туннели слишком извилистые, глубокие и запутанные.","Раньше ты пыталась выследить их до логова, но туннели слишком извилистые, глубокие и запутанные.","Раньше ты пыталась выследить их до логова, но туннели слишком извилистые, глубокие и запутанные.","Раньше ты пыталась выследить их до логова, но туннели слишком извилистые, глубокие и запутанные."],["So instead, you draw them out — just like they lure humans, using their scent to pull people to their deaths. ","Поэтому теперь ты выманиваешь их сама — так же, как они заманивают людей, используя свой запах, чтобы вести их на смерть.","Поэтому теперь ты выманиваешь их сама — так же, как они заманивают людей, используя свой запах, чтобы вести их на смерть.","Поэтому теперь ты выманиваешь их сама — так же, как они заманивают людей, используя свой запах, чтобы вести их на смерть.","Поэтому теперь ты выманиваешь их сама — так же, как они заманивают людей, используя свой запах, чтобы вести их на смерть."],["It’s a brutal contest of hunters, and you intend to be the last one standing. ","Это жестокое состязание охотников, и ты намерена остаться последней, кто устоит на ногах.","Это жестокое состязание охотников, и ты намерена остаться последней, кто устоит на ногах.","Это жестокое состязание охотников, и ты намерена остаться последней, кто устоит на ногах.","Это жестокое состязание охотников, и ты намерена остаться последней, кто устоит на ногах."],["Sliding the gas mask over your face, the rubber cool and constricting against your skin, you settle behind a tree.","Ты натягиваешь противогаз — резина холодная и туго стягивает кожу — и укрываешься за деревом.","Ты натягиваешь противогаз — резина холодная и туго стягивает кожу — и укрываешься за деревом.","Ты натягиваешь противогаз — резина холодная и туго стягивает кожу — и укрываешься за деревом.","Ты натягиваешь противогаз — резина холодная и туго стягивает кожу — и укрываешься за деревом."],["A sharp pang of isolation digs into you. You wish you didn’t have to do this alone, but the remaining townsfolk have… changed. ","Острое чувство одиночества вонзается в тебя. Как бы ты хотела не делать этого одна, но оставшиеся горожане… изменились.","Острое чувство одиночества вонзается в тебя. Как бы ты хотела не делать этого одна, но оставшиеся горожане… изменились.","Острое чувство одиночества вонзается в тебя. Как бы ты хотела не делать этого одна, но оставшиеся горожане… изменились.","Острое чувство одиночества вонзается в тебя. Как бы ты хотела не делать этого одна, но оставшиеся горожане… изменились."],["Consumed by whatever the creatures emit, they’ve become something else. Something hollow. You need to put a stop to this before they sacrifice someone else.","Одурманенные тем, что выделяют эти твари, они стали кем-то другим. Пустыми оболочками. Ты должна положить этому конец, пока они не принесли в жертву кого-то ещё.","Одурманенные тем, что выделяют эти твари, они стали кем-то другим. Пустыми оболочками. Ты должна положить этому конец, пока они не принесли в жертву кого-то ещё.","Одурманенные тем, что выделяют эти твари, они стали кем-то другим. Пустыми оболочками. Ты должна положить этому конец, пока они не принесли в жертву кого-то ещё.","Одурманенные тем, что выделяют эти твари, они стали кем-то другим. Пустыми оболочками. Ты должна положить этому конец, пока они не принесли в жертву кого-то ещё."],["The last rays of sunlight disappear, leaving a dense, suffocating silence. It’s as if the forest itself is holding its breath, aware of what’s coming.","Последние лучи солнца гаснут, и наступает густая, удушающая тишина. Лес будто затаил дыхание, чувствуя, что надвигается.","Последние лучи солнца гаснут, и наступает густая, удушающая тишина. Лес будто затаил дыхание, чувствуя, что надвигается.","Последние лучи солнца гаснут, и наступает густая, удушающая тишина. Лес будто затаил дыхание, чувствуя, что надвигается.","Последние лучи солнца гаснут, и наступает густая, удушающая тишина. Лес будто затаил дыхание, чувствуя, что надвигается."],["Your hands tremble slightly as you grip the flamethrower, its metal cold despite the sweat on your palms.","Руки слегка дрожат, пока ты сжимаешь огнемёт: металл холодный, хотя ладони мокры от пота.","Руки слегка дрожат, пока ты сжимаешь огнемёт: металл холодный, хотя ладони мокры от пота.","Руки слегка дрожат, пока ты сжимаешь огнемёт: металл холодный, хотя ладони мокры от пота.","Руки слегка дрожат, пока ты сжимаешь огнемёт: металл холодный, хотя ладони мокры от пота."],["As soon as the creatures step into the clearing, the explosives will rip through the first wave, and the barbed wire will hold the rest in place.","Стоит существам ступить на поляну — взрывчатка разнесёт первую волну, а колючая проволока задержит остальных.","Стоит существам ступить на поляну — взрывчатка разнесёт первую волну, а колючая проволока задержит остальных.","Стоит существам ступить на поляну — взрывчатка разнесёт первую волну, а колючая проволока задержит остальных.","Стоит существам ступить на поляну — взрывчатка разнесёт первую волну, а колючая проволока задержит остальных."],["Then more will come. You’ll pick them off, wave by wave, until nothing’s left but ash. ","Потом хлынут новые. Ты будешь выкашивать их волну за волной, пока не останется один пепел.","Потом хлынут новые. Ты будешь выкашивать их волну за волной, пока не останется один пепел.","Потом хлынут новые. Ты будешь выкашивать их волну за волной, пока не останется один пепел.","Потом хлынут новые. Ты будешь выкашивать их волну за волной, пока не останется один пепел."],["After all these years of hunting, it all comes down to this. Tonight, either you kill them all, or they finally take you.","После стольких лет охоты всё решится этой ночью. Либо ты убьёшь их всех, либо они наконец заберут тебя.","После стольких лет охоты всё решится этой ночью. Либо ты убьёшь их всех, либо они наконец заберут тебя.","После стольких лет охоты всё решится этой ночью. Либо ты убьёшь их всех, либо они наконец заберут тебя.","После стольких лет охоты всё решится этой ночью. Либо ты убьёшь их всех, либо они наконец заберут тебя."],["leon","leon","leon","leon","leon"],["normal","normal","normal","normal","normal"],["Leon drives into the city, the streets dead and abandoned — another ghost town, courtesy of Umbrella.","Леон въезжает в город. Улицы мертвы и пусты — очередной город-призрак, наследие Umbrella.","Леон въезжает в город. Улицы мертвы и пусты — очередной город-призрак, наследие Umbrella.","Леон въезжает в город. Улицы мертвы и пусты — очередной город-призрак, наследие Umbrella.","Леон въезжает в город. Улицы мертвы и пусты — очередной город-призрак, наследие Umbrella."],["Boarded windows, doors nailed shut, like they’re trying to keep something out. Or in.","Окна заколочены, двери забиты гвоздями, будто жители пытаются не впустить что-то. Или не выпустить.","Окна заколочены, двери забиты гвоздями, будто жители пытаются не впустить что-то. Или не выпустить.","Окна заколочены, двери забиты гвоздями, будто жители пытаются не впустить что-то. Или не выпустить.","Окна заколочены, двери забиты гвоздями, будто жители пытаются не впустить что-то. Или не выпустить."],["He wonders how many more are there. He thought that after Umbrella’s downfall, they had dealt with all of them. But every now and then another one pops up.","Он гадает, сколько таких мест ещё осталось. Он думал, что после падения Umbrella с ними покончено. Но время от времени всплывает новое.","Он гадает, сколько таких мест ещё осталось. Он думал, что после падения Umbrella с ними покончено. Но время от времени всплывает новое.","Он гадает, сколько таких мест ещё осталось. Он думал, что после падения Umbrella с ними покончено. Но время от времени всплывает новое.","Он гадает, сколько таких мест ещё осталось. Он думал, что после падения Umbrella с ними покончено. Но время от времени всплывает новое."],["He feels it — a prickle on the back of his neck. ","Он чувствует это — покалывание в затылке.","Он чувствует это — покалывание в затылке.","Он чувствует это — покалывание в затылке.","Он чувствует это — покалывание в затылке."],["His eyes flick to a cracked window as he passes, but there’s nothing there. Just shadows, shifting with the last light of day.","Проезжая мимо, он бросает взгляд на разбитое окно, но там ничего нет. Только тени, ползущие вместе с последним светом дня.","Проезжая мимо, он бросает взгляд на разбитое окно, но там ничего нет. Только тени, ползущие вместе с последним светом дня.","Проезжая мимо, он бросает взгляд на разбитое окно, но там ничего нет. Только тени, ползущие вместе с последним светом дня.","Проезжая мимо, он бросает взгляд на разбитое окно, но там ничего нет. Только тени, ползущие вместе с последним светом дня."],["Leon","Леон","Леон","Леон","Леон"],["Hate it when the neighbors are this quiet.","Терпеть не могу, когда соседи ведут себя так тихо.","Терпеть не могу, когда соседи ведут себя так тихо.","Терпеть не могу, когда соседи ведут себя так тихо.","Терпеть не могу, когда соседи ведут себя так тихо."],["The sun sinks lower, bleeding orange and red across the sky. He sighs, tapping his fingers on the handlebars.","Солнце клонится к закату, окрашивая небо в оранжевые и красные тона. Он вздыхает, барабаня пальцами по рулю.","Солнце клонится к закату, окрашивая небо в оранжевые и красные тона. Он вздыхает, барабаня пальцами по рулю.","Солнце клонится к закату, окрашивая небо в оранжевые и красные тона. Он вздыхает, барабаня пальцами по рулю.","Солнце клонится к закату, окрашивая небо в оранжевые и красные тона. Он вздыхает, барабаня пальцами по рулю."],["He wanted to get here earlier, but the mission briefing dragged on, and the local cops weren’t exactly helpful. ","Он хотел приехать раньше, но брифинг затянулся, а местные копы оказались не слишком полезны.","Он хотел приехать раньше, но брифинг затянулся, а местные копы оказались не слишком полезны.","Он хотел приехать раньше, но брифинг затянулся, а местные копы оказались не слишком полезны.","Он хотел приехать раньше, но брифинг затянулся, а местные копы оказались не слишком полезны."],["When he asked if they’d seen anything strange, they all gave him the same blank stare. Nope. Nothing, sir.","Когда он спросил, не замечали ли они чего-нибудь странного, все посмотрели на него одинаково пустым взглядом. Нет, ничего, сэр.","Когда он спросил, не замечали ли они чего-нибудь странного, все посмотрели на него одинаково пустым взглядом. Нет, ничего, сэр.","Когда он спросил, не замечали ли они чего-нибудь странного, все посмотрели на него одинаково пустым взглядом. Нет, ничего, сэр.","Когда он спросил, не замечали ли они чего-нибудь странного, все посмотрели на него одинаково пустым взглядом. Нет, ничего, сэр."],["He’s not sure if they’re lying, clueless, or just terrified.","Он не уверен, лгут они, ничего не знают или просто напуганы.","Он не уверен, лгут они, ничего не знают или просто напуганы.","Он не уверен, лгут они, ничего не знают или просто напуганы.","Он не уверен, лгут они, ничего не знают или просто напуганы."],["His GPS flashes, guiding him toward the lab on the outskirts. It’s nestled in the forest, up on a hill. ","Навигатор мигает, указывая путь к лаборатории на окраине. Она спрятана в лесу, на холме.","Навигатор мигает, указывая путь к лаборатории на окраине. Она спрятана в лесу, на холме.","Навигатор мигает, указывая путь к лаборатории на окраине. Она спрятана в лесу, на холме.","Навигатор мигает, указывая путь к лаборатории на окраине. Она спрятана в лесу, на холме."],["Easy enough, right? Just find the missing team, check the lab, and get out.","Проще простого, верно? Найти пропавшую команду, осмотреть лабораторию и убраться.","Проще простого, верно? Найти пропавшую команду, осмотреть лабораторию и убраться.","Проще простого, верно? Найти пропавшую команду, осмотреть лабораторию и убраться.","Проще простого, верно? Найти пропавшую команду, осмотреть лабораторию и убраться."],["Simple.","Ничего сложного.","Ничего сложного.","Ничего сложного.","Ничего сложного."],["Except it never is.","Вот только так не бывает никогда.","Вот только так не бывает никогда.","Вот только так не бывает никогда.","Вот только так не бывает никогда."],["Leon kills the engine and swings off the bike, the silence wrapping around him. The air feels... wrong. Too still. The kind of stillness that gets under your skin.","Леон глушит двигатель и спрыгивает с мотоцикла; тишина смыкается вокруг него. Воздух кажется… неправильным. Слишком неподвижным — той неподвижностью, что забирается под кожу.","Леон глушит двигатель и спрыгивает с мотоцикла; тишина смыкается вокруг него. Воздух кажется… неправильным. Слишком неподвижным — той неподвижностью, что забирается под кожу.","Леон глушит двигатель и спрыгивает с мотоцикла; тишина смыкается вокруг него. Воздух кажется… неправильным. Слишком неподвижным — той неподвижностью, что забирается под кожу.","Леон глушит двигатель и спрыгивает с мотоцикла; тишина смыкается вокруг него. Воздух кажется… неправильным. Слишком неподвижным — той неподвижностью, что забирается под кожу."],["Okay, Leon. Just another spooky forest. What could go wrong?","Ладно, Леон. Очередной жуткий лес. Что может пойти не так?","Ладно, Леон. Очередной жуткий лес. Что может пойти не так?","Ладно, Леон. Очередной жуткий лес. Что может пойти не так?","Ладно, Леон. Очередной жуткий лес. Что может пойти не так?"],["He moves on foot, the ground soft under his boots, dead leaves muffling his steps. His hand hovers near his gun. The path is narrow, overgrown, and the shadows stretch out long in the fading light.","Дальше он идёт пешком. Земля мягкая под ботинками, сухие листья глушат шаги. Рука замирает у пистолета. Тропа узкая, заросшая, а тени в меркнущем свете вытягиваются всё длиннее.","Дальше он идёт пешком. Земля мягкая под ботинками, сухие листья глушат шаги. Рука замирает у пистолета. Тропа узкая, заросшая, а тени в меркнущем свете вытягиваются всё длиннее.","Дальше он идёт пешком. Земля мягкая под ботинками, сухие листья глушат шаги. Рука замирает у пистолета. Тропа узкая, заросшая, а тени в меркнущем свете вытягиваются всё длиннее.","Дальше он идёт пешком. Земля мягкая под ботинками, сухие листья глушат шаги. Рука замирает у пистолета. Тропа узкая, заросшая, а тени в меркнущем свете вытягиваются всё длиннее."],["Then he sees it — a flickering light through the trees. ","Вдруг он замечает сквозь деревья мерцающий свет.","Вдруг он замечает сквозь деревья мерцающий свет.","Вдруг он замечает сквозь деревья мерцающий свет.","Вдруг он замечает сквозь деревья мерцающий свет."],["Leon stops, narrowing his eyes. Someone’s here. Maybe it’s the missing team. Or something else.","Леон останавливается и щурится. Здесь кто-то есть. Может, пропавшая команда. А может, что-то другое.","Леон останавливается и щурится. Здесь кто-то есть. Может, пропавшая команда. А может, что-то другое.","Леон останавливается и щурится. Здесь кто-то есть. Может, пропавшая команда. А может, что-то другое.","Леон останавливается и щурится. Здесь кто-то есть. Может, пропавшая команда. А может, что-то другое."],["He steps off the path, crouching low behind a tree for cover, watching the bonfire pulse in the dark.","Он сходит с тропы и пригибается за деревом, наблюдая, как в темноте пульсирует костёр.","Он сходит с тропы и пригибается за деревом, наблюдая, как в темноте пульсирует костёр.","Он сходит с тропы и пригибается за деревом, наблюдая, как в темноте пульсирует костёр.","Он сходит с тропы и пригибается за деревом, наблюдая, как в темноте пульсирует костёр."],["Whoever’s camping out here has terrible taste in ambiance. ","Тот, кто здесь заночевал, явно не силён в создании уюта.","Тот, кто здесь заночевал, явно не силён в создании уюта.","Тот, кто здесь заночевал, явно не силён в создании уюта.","Тот, кто здесь заночевал, явно не силён в создании уюта."],["Then a faint smell hits him — sweet, cloying, almost floral.","И тут до него долетает слабый запах — сладкий, приторный, почти цветочный.","И тут до него долетает слабый запах — сладкий, приторный, почти цветочный.","И тут до него долетает слабый запах — сладкий, приторный, почти цветочный.","И тут до него долетает слабый запах — сладкий, приторный, почти цветочный."],["angry","angry","angry","angry","angry"],["He grips his gun tighter, muscles tensing as his instincts kick in. This isn’t the usual rotting stench of B.O.W.s. This is... different. Wrong. Whatever’s ahead, it feels like it’s calling to him.","Он крепче сжимает пистолет, мышцы напрягаются: срабатывают инстинкты. Это не привычная вонь гниющих Б.О.О. Это… другое. Неправильное. Что бы ни ждало впереди, оно будто зовёт его.","Он крепче сжимает пистолет, мышцы напрягаются: срабатывают инстинкты. Это не привычная вонь гниющих Б.О.О. Это… другое. Неправильное. Что бы ни ждало впереди, оно будто зовёт его.","Он крепче сжимает пистолет, мышцы напрягаются: срабатывают инстинкты. Это не привычная вонь гниющих Б.О.О. Это… другое. Неправильное. Что бы ни ждало впереди, оно будто зовёт его.","Он крепче сжимает пистолет, мышцы напрягаются: срабатывают инстинкты. Это не привычная вонь гниющих Б.О.О. Это… другое. Неправильное. Что бы ни ждало впереди, оно будто зовёт его."],["The last of the sunlight slips behind the trees. Darkness closes in, and the light flickers again, casting eerie shadows that seem to reach for him.","Последние отблески солнца тонут за деревьями. Тьма смыкается, и свет снова дрожит, отбрасывая жуткие тени, которые словно тянутся к нему.","Последние отблески солнца тонут за деревьями. Тьма смыкается, и свет снова дрожит, отбрасывая жуткие тени, которые словно тянутся к нему.","Последние отблески солнца тонут за деревьями. Тьма смыкается, и свет снова дрожит, отбрасывая жуткие тени, которые словно тянутся к нему.","Последние отблески солнца тонут за деревьями. Тьма смыкается, и свет снова дрожит, отбрасывая жуткие тени, которые словно тянутся к нему."],["He moves forward, slow and steady, his senses on high alert. He’s done this before, more times than he’d care to remember. ","Он медленно и уверенно движется вперёд, все чувства на пределе. Он проходил через это и раньше — чаще, чем хотел бы помнить.","Он медленно и уверенно движется вперёд, все чувства на пределе. Он проходил через это и раньше — чаще, чем хотел бы помнить.","Он медленно и уверенно движется вперёд, все чувства на пределе. Он проходил через это и раньше — чаще, чем хотел бы помнить.","Он медленно и уверенно движется вперёд, все чувства на пределе. Он проходил через это и раньше — чаще, чем хотел бы помнить."],["Whatever’s waiting in the dark, it’s not going to catch him off guard.","Что бы ни поджидало во тьме, застать его врасплох ему не удастся.","Что бы ни поджидало во тьме, застать его врасплох ему не удастся.","Что бы ни поджидало во тьме, застать его врасплох ему не удастся.","Что бы ни поджидало во тьме, застать его врасплох ему не удастся."],["Leon’s head is getting foggy, his senses dulled. He can see the fire now — a huge bonfire lighting up the dark.","Голова Леона наливается туманом, чувства притупляются. Теперь он видит огонь — огромный костёр, освещающий ночь.","Голова Леона наливается туманом, чувства притупляются. Теперь он видит огонь — огромный костёр, освещающий ночь.","Голова Леона наливается туманом, чувства притупляются. Теперь он видит огонь — огромный костёр, освещающий ночь.","Голова Леона наливается туманом, чувства притупляются. Теперь он видит огонь — огромный костёр, освещающий ночь."],["Spotting an opening, he steps forward, but something brushes against his chest — a wire.","Заметив просвет, он делает шаг вперёд, но что-то касается его груди — проволока.","Заметив просвет, он делает шаг вперёд, но что-то касается его груди — проволока.","Заметив просвет, он делает шаг вперёд, но что-то касается его груди — проволока.","Заметив просвет, он делает шаг вперёд, но что-то касается его груди — проволока."],["The faint beeping reaches him a second too late. ","Тихий писк доносится до него секундой позже, чем следовало.","Тихий писк доносится до него секундой позже, чем следовало.","Тихий писк доносится до него секундой позже, чем следовало.","Тихий писк доносится до него секундой позже, чем следовало."],["surp","surp","surp","surp","surp"],["Guess I really walked into that one.","Похоже, я сам на это напросился.","Похоже, я сам на это напросился.","Похоже, я сам на это напросился.","Похоже, я сам на это напросился."],["The tripwire triggers, a deafening blast tearing through the air. ","Растяжка срабатывает, и оглушительный взрыв разрывает воздух.","Растяжка срабатывает, и оглушительный взрыв разрывает воздух.","Растяжка срабатывает, и оглушительный взрыв разрывает воздух.","Растяжка срабатывает, и оглушительный взрыв разрывает воздух."],["You listen, breath fogging the inside of your gas mask. The forest feels suffocating, every shadow pressing in, thick with tension.","Ты вслушиваешься; дыхание запотевает внутри противогаза. Лес кажется душным, каждая тень давит, налитая напряжением.","Ты вслушиваешься; дыхание запотевает внутри противогаза. Лес кажется душным, каждая тень давит, налитая напряжением.","Ты вслушиваешься; дыхание запотевает внутри противогаза. Лес кажется душным, каждая тень давит, налитая напряжением.","Ты вслушиваешься; дыхание запотевает внутри противогаза. Лес кажется душным, каждая тень давит, налитая напряжением."],["A sharp, creaking noise breaks the silence — the sound of chitinous legs scraping over dry bark. The familiar clicks and snaps you’ve come to associate with the creatures.","Резкий скрипучий звук нарушает тишину — хитиновые лапы скребут по сухой коре. Знакомые щелчки и треск, которые ты научилась связывать с этими тварями.","Резкий скрипучий звук нарушает тишину — хитиновые лапы скребут по сухой коре. Знакомые щелчки и треск, которые ты научилась связывать с этими тварями.","Резкий скрипучий звук нарушает тишину — хитиновые лапы скребут по сухой коре. Знакомые щелчки и треск, которые ты научилась связывать с этими тварями.","Резкий скрипучий звук нарушает тишину — хитиновые лапы скребут по сухой коре. Знакомые щелчки и треск, которые ты научилась связывать с этими тварями."],["They’re here.","Они здесь.","Они здесь.","Они здесь.","Они здесь."],["Your heart pounds, and you steady your breath, the filtered air dry and stale against your lips. ","Сердце колотится, ты выравниваешь дыхание: фильтрованный воздух сух и затхл на губах.","Сердце колотится, ты выравниваешь дыхание: фильтрованный воздух сух и затхл на губах.","Сердце колотится, ты выравниваешь дыхание: фильтрованный воздух сух и затхл на губах.","Сердце колотится, ты выравниваешь дыхание: фильтрованный воздух сух и затхл на губах."],["Fingers tightening around the flamethrower, you prepare to rise from your hiding spot, every muscle coiled.","Пальцы крепче смыкаются на огнемёте; ты готовишься подняться из укрытия, каждый мускул натянут.","Пальцы крепче смыкаются на огнемёте; ты готовишься подняться из укрытия, каждый мускул натянут.","Пальцы крепче смыкаются на огнемёте; ты готовишься подняться из укрытия, каждый мускул натянут.","Пальцы крепче смыкаются на огнемёте; ты готовишься подняться из укрытия, каждый мускул натянут."],["But then, movement catches your eye — a figure, slipping through the clearing. ","Но тут что-то мелькает на краю зрения — фигура, скользящая по поляне.","Но тут что-то мелькает на краю зрения — фигура, скользящая по поляне.","Но тут что-то мелькает на краю зрения — фигура, скользящая по поляне.","Но тут что-то мелькает на краю зрения — фигура, скользящая по поляне."],["A man.","Мужчина.","Мужчина.","Мужчина.","Мужчина."],["You freeze, watching as he steps closer to your traps.","Ты замираешь и смотришь, как он приближается к твоим ловушкам.","Ты замираешь и смотришь, как он приближается к твоим ловушкам.","Ты замираешь и смотришь, как он приближается к твоим ловушкам.","Ты замираешь и смотришь, как он приближается к твоим ловушкам."],["Wait. Is he…?","Стой. Неужели он…?","Стой. Неужели он…?","Стой. Неужели он…?","Стой. Неужели он…?"],["He’s disabling your tripwires!","Он обезвреживает твои растяжки!","Он обезвреживает твои растяжки!","Он обезвреживает твои растяжки!","Он обезвреживает твои растяжки!"],["Your pulse races, heart hammering in your ears. Without thinking, you sprint from your spot, weaving through the traps you’ve committed to memory.","Пульс срывается в галоп, сердце грохочет в ушах. Не раздумывая, ты бросаешься из укрытия, петляя между ловушками, которые помнишь наизусть.","Пульс срывается в галоп, сердце грохочет в ушах. Не раздумывая, ты бросаешься из укрытия, петляя между ловушками, которые помнишь наизусть.","Пульс срывается в галоп, сердце грохочет в ушах. Не раздумывая, ты бросаешься из укрытия, петляя между ловушками, которые помнишь наизусть.","Пульс срывается в галоп, сердце грохочет в ушах. Не раздумывая, ты бросаешься из укрытия, петляя между ловушками, которые помнишь наизусть."],["You","Ты","Ты","Ты","Ты"],["You! Stop!","Ты! Стой!","Ты! Стой!","Ты! Стой!","Ты! Стой!"],["Your voice comes out muffled, distorted by the mask, but he halts, turning to face you.","Голос звучит глухо, искажённый маской, но он замирает и оборачивается.","Голос звучит глухо, искажённый маской, но он замирает и оборачивается.","Голос звучит глухо, искажённый маской, но он замирает и оборачивается.","Голос звучит глухо, искажённый маской, но он замирает и оборачивается."],["For a split second, you’re taken aback. He’s... not what you expected. Sharp features, piercing eyes. Striking, in a way that seems out of place here.","На долю секунды ты теряешься. Он… не такой, как ты ожидала. Резкие черты, пронзительный взгляд. Привлекательный — до неуместности для этих мест.","На долю секунды ты теряешься. Он… не такой, как ты ожидала. Резкие черты, пронзительный взгляд. Привлекательный — до неуместности для этих мест.","На долю секунды ты теряешься. Он… не такой, как ты ожидала. Резкие черты, пронзительный взгляд. Привлекательный — до неуместности для этих мест.","На долю секунды ты теряешься. Он… не такой, как ты ожидала. Резкие черты, пронзительный взгляд. Привлекательный — до неуместности для этих мест."],["Not the kind of person you’d expect to stumble into a nightmare like this.","Совсем не тот, кого ждёшь встретить в подобном кошмаре.","Совсем не тот, кого ждёшь встретить в подобном кошмаре.","Совсем не тот, кого ждёшь встретить в подобном кошмаре.","Совсем не тот, кого ждёшь встретить в подобном кошмаре."],["Your gaze flicks to his hand — hovering near his gun, posture tense and controlled. Definitely not a civilian.","Твой взгляд падает на его руку — она застыла у пистолета, поза напряжённая и собранная. Точно не гражданский.","Твой взгляд падает на его руку — она застыла у пистолета, поза напряжённая и собранная. Точно не гражданский.","Твой взгляд падает на его руку — она застыла у пистолета, поза напряжённая и собранная. Точно не гражданский.","Твой взгляд падает на его руку — она застыла у пистолета, поза напряжённая и собранная. Точно не гражданский."],["What the hell do you think you’re doing?","Какого чёрта ты творишь?","Какого чёрта ты творишь?","Какого чёрта ты творишь?","Какого чёрта ты творишь?"],["These traps are mine.","Эти ловушки — мои.","Эти ловушки — мои.","Эти ловушки — мои.","Эти ловушки — мои."],["eyebrow","eyebrow","eyebrow","eyebrow","eyebrow"],["He raises an eyebrow, unbothered by your tone.","Он приподнимает бровь, ничуть не смущённый твоим тоном.","Он приподнимает бровь, ничуть не смущённый твоим тоном.","Он приподнимает бровь, ничуть не смущённый твоим тоном.","Он приподнимает бровь, ничуть не смущённый твоим тоном."],["Man","Мужчина","Мужчина","Мужчина","Мужчина"],["These are yours?","Эти — твои?","Эти — твои?","Эти — твои?","Эти — твои?"],["Yes.","Да.","Да.","Да.","Да."],["I’d appreciate it if you didn’t mess with them. ","Буду признательна, если ты не станешь в них копаться.","Буду признательна, если ты не станешь в них копаться.","Буду признательна, если ты не станешь в них копаться.","Буду признательна, если ты не станешь в них копаться."],["He glances around at the scattered wires, looking almost amused.","Он оглядывает разбросанные провода, и на его лице мелькает почти веселье.","Он оглядывает разбросанные провода, и на его лице мелькает почти веселье.","Он оглядывает разбросанные провода, и на его лице мелькает почти веселье.","Он оглядывает разбросанные провода, и на его лице мелькает почти веселье."],["Oh. My bad.","О. Виноват.","О. Виноват.","О. Виноват.","О. Виноват."],["How many did you disable already?","Сколько ты уже обезвредил?","Сколько ты уже обезвредил?","Сколько ты уже обезвредил?","Сколько ты уже обезвредил?"],["He tilts his head, thinking for a moment. ","Он склоняет голову, обдумывая ответ.","Он склоняет голову, обдумывая ответ.","Он склоняет голову, обдумывая ответ.","Он склоняет голову, обдумывая ответ."],["A… few.","Ну… несколько.","Ну… несколько.","Ну… несколько.","Ну… несколько."],["You curse under your breath, gripping the flamethrower tighter. Just your luck — a clueless outsider ruining the day you’ve waited years for.","Ты тихо ругаешься и сильнее сжимаешь огнемёт. Как же не повезло — какой-то несведущий чужак срывает день, которого ты ждала годами.","Ты тихо ругаешься и сильнее сжимаешь огнемёт. Как же не повезло — какой-то несведущий чужак срывает день, которого ты ждала годами.","Ты тихо ругаешься и сильнее сжимаешь огнемёт. Как же не повезло — какой-то несведущий чужак срывает день, которого ты ждала годами.","Ты тихо ругаешься и сильнее сжимаешь огнемёт. Как же не повезло — какой-то несведущий чужак срывает день, которого ты ждала годами."],["Why do you need so many explosives?","Зачем тебе столько взрывчатки?","Зачем тебе столько взрывчатки?","Зачем тебе столько взрывчатки?","Зачем тебе столько взрывчатки?"],["I’m hunting.","Я охочусь.","Я охочусь.","Я охочусь.","Я охочусь."],["His eyes shift to the flamethrower in your hands, then to the barbed wire strung between trees. ","Его взгляд перемещается на огнемёт в твоих руках, затем на колючую проволоку между деревьями.","Его взгляд перемещается на огнемёт в твоих руках, затем на колючую проволоку между деревьями.","Его взгляд перемещается на огнемёт в твоих руках, затем на колючую проволоку между деревьями.","Его взгляд перемещается на огнемёт в твоих руках, затем на колючую проволоку между деревьями."],["You have a rather… unconventional way of hunting.","У тебя довольно… нестандартный подход к охоте.","У тебя довольно… нестандартный подход к охоте.","У тебя довольно… нестандартный подход к охоте.","У тебя довольно… нестандартный подход к охоте."],["You take a steadying breath. No time for this.","Ты делаешь глубокий вдох. Не время для этого.","Ты делаешь глубокий вдох. Не время для этого.","Ты делаешь глубокий вдох. Не время для этого.","Ты делаешь глубокий вдох. Не время для этого."],["You’re not from this town, are you? You really should leave. Now.","Ты ведь не местный, так? Тебе стоит уйти. Немедленно.","Ты ведь не местный, так? Тебе стоит уйти. Немедленно.","Ты ведь не местный, так? Тебе стоит уйти. Немедленно.","Ты ведь не местный, так? Тебе стоит уйти. Немедленно."],["Your gaze drifts to the treeline, where you sense movement. The scent is starting to seep in, that sickly-sweet, floral odor the creatures emit.","Ты бросаешь взгляд на кромку леса, где чувствуешь движение. Запах уже просачивается — тот самый приторно-сладкий цветочный аромат, что источают эти существа.","Ты бросаешь взгляд на кромку леса, где чувствуешь движение. Запах уже просачивается — тот самый приторно-сладкий цветочный аромат, что источают эти существа.","Ты бросаешь взгляд на кромку леса, где чувствуешь движение. Запах уже просачивается — тот самый приторно-сладкий цветочный аромат, что источают эти существа.","Ты бросаешь взгляд на кромку леса, где чувствуешь движение. Запах уже просачивается — тот самый приторно-сладкий цветочный аромат, что источают эти существа."],["He’s not wearing a mask — already, you see a slight daze in his eyes. He won’t last long if they get too close.","Маски на нём нет — в глазах уже заметна лёгкая дымка. Долго он не продержится, если они подберутся ближе.","Маски на нём нет — в глазах уже заметна лёгкая дымка. Долго он не продержится, если они подберутся ближе.","Маски на нём нет — в глазах уже заметна лёгкая дымка. Долго он не продержится, если они подберутся ближе.","Маски на нём нет — в глазах уже заметна лёгкая дымка. Долго он не продержится, если они подберутся ближе."],["The man shakes his head, taking a step closer.","Мужчина качает головой и подступает на шаг.","Мужчина качает головой и подступает на шаг.","Мужчина качает головой и подступает на шаг.","Мужчина качает головой и подступает на шаг."],["Not an option. I’ve got to get to that lab, and this is the only way through.","Не выйдет. Мне нужно попасть в ту лабораторию, а другого пути нет.","Не выйдет. Мне нужно попасть в ту лабораторию, а другого пути нет.","Не выйдет. Мне нужно попасть в ту лабораторию, а другого пути нет.","Не выйдет. Мне нужно попасть в ту лабораторию, а другого пути нет."],["You fidget with the flamethrower, torn between curiosity and frustration. Whoever he is, he needs to leave.","Ты нервно вертишь огнемёт, разрываясь между любопытством и досадой. Кем бы он ни был, ему нужно убраться отсюда.","Ты нервно вертишь огнемёт, разрываясь между любопытством и досадой. Кем бы он ни был, ему нужно убраться отсюда.","Ты нервно вертишь огнемёт, разрываясь между любопытством и досадой. Кем бы он ни был, ему нужно убраться отсюда.","Ты нервно вертишь огнемёт, разрываясь между любопытством и досадой. Кем бы он ни был, ему нужно убраться отсюда."],["You have no idea what’s out there. Turn around. Wait until morning. Whatever you’re looking for at the lab — it’s already been ransacked.","Ты понятия не имеешь, что там, в лесу. Возвращайся. Подожди до утра. Что бы ты ни искал в лаборатории — её уже растащили.","Ты понятия не имеешь, что там, в лесу. Возвращайся. Подожди до утра. Что бы ты ни искал в лаборатории — её уже растащили.","Ты понятия не имеешь, что там, в лесу. Возвращайся. Подожди до утра. Что бы ты ни искал в лаборатории — её уже растащили.","Ты понятия не имеешь, что там, в лесу. Возвращайся. Подожди до утра. Что бы ты ни искал в лаборатории — её уже растащили."],["But do whatever you want, just not right now.","Но поступай как знаешь. Только не сейчас.","Но поступай как знаешь. Только не сейчас.","Но поступай как знаешь. Только не сейчас.","Но поступай как знаешь. Только не сейчас."],["A familiar sound echoes through the forest — the same clicking, the same sickening creak. They’re getting closer. He hears it too, his stance shifting, eyes narrowing. ","Знакомый звук эхом разносится по лесу — те же щелчки, тот же тошнотворный скрип. Они приближаются. Он тоже слышит: стойка меняется, глаза сужаются.","Знакомый звук эхом разносится по лесу — те же щелчки, тот же тошнотворный скрип. Они приближаются. Он тоже слышит: стойка меняется, глаза сужаются.","Знакомый звук эхом разносится по лесу — те же щелчки, тот же тошнотворный скрип. Они приближаются. Он тоже слышит: стойка меняется, глаза сужаются.","Знакомый звук эхом разносится по лесу — те же щелчки, тот же тошнотворный скрип. Они приближаются. Он тоже слышит: стойка меняется, глаза сужаются."],["What exactly are you hunting?","На кого именно ты охотишься?","На кого именно ты охотишься?","На кого именно ты охотишься?","На кого именно ты охотишься?"],["Before you can respond, yellow eyes blink to life at the edge of the woods. Dozens of them, gleaming like fireflies in the dark, shifting as they lock onto you.","Ты не успеваешь ответить: на опушке вспыхивают жёлтые глаза. Десятки, мерцающие, как светлячки в темноте; они смещаются, вцепляясь в тебя взглядом.","Ты не успеваешь ответить: на опушке вспыхивают жёлтые глаза. Десятки, мерцающие, как светлячки в темноте; они смещаются, вцепляясь в тебя взглядом.","Ты не успеваешь ответить: на опушке вспыхивают жёлтые глаза. Десятки, мерцающие, как светлячки в темноте; они смещаются, вцепляясь в тебя взглядом.","Ты не успеваешь ответить: на опушке вспыхивают жёлтые глаза. Десятки, мерцающие, как светлячки в темноте; они смещаются, вцепляясь в тебя взглядом."],["There are more than you expected, likely drawn by his scent as well. You can’t fight them all without the explosives.","Их больше, чем ты рассчитывала; вероятно, их привлёк и его запах. Без взрывчатки со всеми не справиться.","Их больше, чем ты рассчитывала; вероятно, их привлёк и его запах. Без взрывчатки со всеми не справиться.","Их больше, чем ты рассчитывала; вероятно, их привлёк и его запах. Без взрывчатки со всеми не справиться.","Их больше, чем ты рассчитывала; вероятно, их привлёк и его запах. Без взрывчатки со всеми не справиться."],["Run.","Беги.","Беги.","Беги.","Беги."],["You don’t wait for his response. Explosions erupt, the ground shaking underfoot, but the creatures charge through the smoke, faster than you anticipated.","Ты не ждёшь его ответа. Гремят взрывы, земля дрожит под ногами, но существа прорываются сквозь дым — быстрее, чем ты думала.","Ты не ждёшь его ответа. Гремят взрывы, земля дрожит под ногами, но существа прорываются сквозь дым — быстрее, чем ты думала.","Ты не ждёшь его ответа. Гремят взрывы, земля дрожит под ногами, но существа прорываются сквозь дым — быстрее, чем ты думала.","Ты не ждёшь его ответа. Гремят взрывы, земля дрожит под ногами, но существа прорываются сквозь дым — быстрее, чем ты думала."],["You dash forward, dodging traps, weaving through the maze of wires and explosives. ","Ты мчишься вперёд, огибая ловушки, петляя в лабиринте проводов и взрывчатки.","Ты мчишься вперёд, огибая ловушки, петляя в лабиринте проводов и взрывчатки.","Ты мчишься вперёд, огибая ловушки, петляя в лабиринте проводов и взрывчатки.","Ты мчишься вперёд, огибая ловушки, петляя в лабиринте проводов и взрывчатки."],["Gunshots ring out behind you. You glance back, catching sight of him — firing at the creatures as he runs, somehow keeping pace. ","Позади раздаются выстрелы. Ты оглядываешься и видишь его: он стреляет по существам на бегу и каким-то чудом не отстаёт.","Позади раздаются выстрелы. Ты оглядываешься и видишь его: он стреляет по существам на бегу и каким-то чудом не отстаёт.","Позади раздаются выстрелы. Ты оглядываешься и видишь его: он стреляет по существам на бегу и каким-то чудом не отстаёт.","Позади раздаются выстрелы. Ты оглядываешься и видишь его: он стреляет по существам на бегу и каким-то чудом не отстаёт."],["Save your bullets! It won't kill them!","Не трать патроны! Их это не убьёт!","Не трать патроны! Их это не убьёт!","Не трать патроны! Их это не убьёт!","Не трать патроны! Их это не убьёт!"],["A sharp crack sounds, and suddenly, warm air seeps into the mask. A piece of debris must have punctured it.","Раздаётся резкий треск, и внезапно в маску просачивается тёплый воздух. Видимо, её пробил осколок.","Раздаётся резкий треск, и внезапно в маску просачивается тёплый воздух. Видимо, её пробил осколок.","Раздаётся резкий треск, и внезапно в маску просачивается тёплый воздух. Видимо, её пробил осколок.","Раздаётся резкий треск, и внезапно в маску просачивается тёплый воздух. Видимо, её пробил осколок."],["You’re exposed now, no spare within reach. You can only keep running.","Теперь ты уязвима, а запасной маски под рукой нет. Остаётся только бежать.","Теперь ты уязвима, а запасной маски под рукой нет. Остаётся только бежать.","Теперь ты уязвима, а запасной маски под рукой нет. Остаётся только бежать.","Теперь ты уязвима, а запасной маски под рукой нет. Остаётся только бежать."],["Barreling through the underbrush, you fire the flamethrower behind you, a wave of fire scorching the air. The creatures shriek and stumble back, but keep coming.","Ты продираешься сквозь подлесок и выпускаешь огонь назад — волна пламени опаляет воздух. Существа визжат и отшатываются, но не прекращают погоню.","Ты продираешься сквозь подлесок и выпускаешь огонь назад — волна пламени опаляет воздух. Существа визжат и отшатываются, но не прекращают погоню.","Ты продираешься сквозь подлесок и выпускаешь огонь назад — волна пламени опаляет воздух. Существа визжат и отшатываются, но не прекращают погоню.","Ты продираешься сквозь подлесок и выпускаешь огонь назад — волна пламени опаляет воздух. Существа визжат и отшатываются, но не прекращают погоню."],["You see him aim, shooting one of the explosives rigged to a nearby tree. ","Ты видишь, как он прицеливается и стреляет в одну из мин, закреплённых на ближайшем дереве.","Ты видишь, как он прицеливается и стреляет в одну из мин, закреплённых на ближайшем дереве.","Ты видишь, как он прицеливается и стреляет в одну из мин, закреплённых на ближайшем дереве.","Ты видишь, как он прицеливается и стреляет в одну из мин, закреплённых на ближайшем дереве."],["The explosion rocks the clearing, and smoke blankets everything, the forest erupting into chaos. ","Взрыв сотрясает поляну, дым застилает всё вокруг, и лес тонет в хаосе.","Взрыв сотрясает поляну, дым застилает всё вокруг, и лес тонет в хаосе.","Взрыв сотрясает поляну, дым застилает всё вокруг, и лес тонет в хаосе.","Взрыв сотрясает поляну, дым застилает всё вокруг, и лес тонет в хаосе."],["You run until you’re far away, gasping as you tear off the broken mask.","Ты бежишь, пока не оказываешься далеко, и, задыхаясь, срываешь испорченную маску.","Ты бежишь, пока не оказываешься далеко, и, задыхаясь, срываешь испорченную маску.","Ты бежишь, пока не оказываешься далеко, и, задыхаясь, срываешь испорченную маску.","Ты бежишь, пока не оказываешься далеко, и, задыхаясь, срываешь испорченную маску."],["The cool night air fills your lungs, but it feels like failure. Everything you built is gone. The traps, the explosives — all of it, wasted.","Прохладный ночной воздух наполняет лёгкие, но ощущается как поражение. Всё, что ты построила, пропало. Ловушки, взрывчатка — всё впустую.","Прохладный ночной воздух наполняет лёгкие, но ощущается как поражение. Всё, что ты построила, пропало. Ловушки, взрывчатка — всё впустую.","Прохладный ночной воздух наполняет лёгкие, но ощущается как поражение. Всё, что ты построила, пропало. Ловушки, взрывчатка — всё впустую.","Прохладный ночной воздух наполняет лёгкие, но ощущается как поражение. Всё, что ты построила, пропало. Ловушки, взрывчатка — всё впустую."],["The man catches up, glancing back at the smoke and fire flickering in the distance. His gun is still in hand, and he looks... unfazed.","Мужчина нагоняет тебя и оглядывается на дым и огонь, мерцающие вдали. Пистолет по-прежнему в руке, а сам он выглядит… невозмутимым.","Мужчина нагоняет тебя и оглядывается на дым и огонь, мерцающие вдали. Пистолет по-прежнему в руке, а сам он выглядит… невозмутимым.","Мужчина нагоняет тебя и оглядывается на дым и огонь, мерцающие вдали. Пистолет по-прежнему в руке, а сам он выглядит… невозмутимым.","Мужчина нагоняет тебя и оглядывается на дым и огонь, мерцающие вдали. Пистолет по-прежнему в руке, а сам он выглядит… невозмутимым."],["Quite the fireworks show back there.","Знатный фейерверк там получился.","Знатный фейерверк там получился.","Знатный фейерверк там получился.","Знатный фейерверк там получился."],["He looks at you, raising an eyebrow. ","Он смотрит на тебя, приподняв бровь.","Он смотрит на тебя, приподняв бровь.","Он смотрит на тебя, приподняв бровь.","Он смотрит на тебя, приподняв бровь."],["What were those things? You’ve fought them before, right? ","Что это были за твари? Ты ведь уже сталкивалась с ними?","Что это были за твари? Ты ведь уже сталкивалась с ними?","Что это были за твари? Ты ведь уже сталкивалась с ними?","Что это были за твари? Ты ведь уже сталкивалась с ними?"],["Your blood boils, and you throw the broken mask to the ground. ","Кровь закипает, и ты швыряешь сломанную маску на землю.","Кровь закипает, и ты швыряешь сломанную маску на землю.","Кровь закипает, и ты швыряешь сломанную маску на землю.","Кровь закипает, и ты швыряешь сломанную маску на землю."],["It’s your fault","Это твоя вина","Это твоя вина","Это твоя вина","Это твоя вина"],["It’s his fault","Это его вина","Это его вина","Это его вина","Это его вина"],["You should’ve kept going. Should’ve stuck with the plan and ignored the outsider. Your fury fades, giving way to a hollow sense of defeat. ","Тебе надо было идти дальше. Держаться плана и не обращать внимания на чужака. Ярость гаснет, и на её место приходит пустое чувство поражения.","Тебе надо было идти дальше. Держаться плана и не обращать внимания на чужака. Ярость гаснет, и на её место приходит пустое чувство поражения.","Тебе надо было идти дальше. Держаться плана и не обращать внимания на чужака. Ярость гаснет, и на её место приходит пустое чувство поражения.","Тебе надо было идти дальше. Держаться плана и не обращать внимания на чужака. Ярость гаснет, и на её место приходит пустое чувство поражения."],["I prepared for this day for a long time. I was going to kill all of them.","Я долго готовилась к этому дню. Я собиралась убить их всех.","Я долго готовилась к этому дню. Я собиралась убить их всех.","Я долго готовилась к этому дню. Я собиралась убить их всех.","Я долго готовилась к этому дню. Я собиралась убить их всех."],["There’s no way you could’ve taken them all down on your own.","В одиночку ты бы не смогла расправиться со всеми.","В одиночку ты бы не смогла расправиться со всеми.","В одиночку ты бы не смогла расправиться со всеми.","В одиночку ты бы не смогла расправиться со всеми."],["You shake your head, chuckling low as tears prickle at your eyes. You have no energy left to argue. ","Ты качаешь головой, тихо усмехаясь; на глаза наворачиваются слёзы. Спорить нет сил.","Ты качаешь головой, тихо усмехаясь; на глаза наворачиваются слёзы. Спорить нет сил.","Ты качаешь головой, тихо усмехаясь; на глаза наворачиваются слёзы. Спорить нет сил.","Ты качаешь головой, тихо усмехаясь; на глаза наворачиваются слёзы. Спорить нет сил."],["Right. I should’ve know. I’ve already failed so many people… what’s one more mistake? ","Ну конечно. Мне следовало знать. Я уже подвела столько людей… что для меня ещё одна ошибка?","Ну конечно. Мне следовало знать. Я уже подвела столько людей… что для меня ещё одна ошибка?","Ну конечно. Мне следовало знать. Я уже подвела столько людей… что для меня ещё одна ошибка?","Ну конечно. Мне следовало знать. Я уже подвела столько людей… что для меня ещё одна ошибка?"],["Look, I didn’t mean to mess things up— ","Слушай, я не хотел всё испортить—","Слушай, я не хотел всё испортить—","Слушай, я не хотел всё испортить—","Слушай, я не хотел всё испортить—"],["It’s all your fault!","Это всё твоя вина!","Это всё твоя вина!","Это всё твоя вина!","Это всё твоя вина!"],["What?","Что?","Что?","Что?","Что?"],["I was going to kill every last one of them. I had everything set. And you ruined it. You ruined everything! ","Я собиралась убить каждого из них. У меня всё было готово. А ты всё испортил. Ты испортил всё!","Я собиралась убить каждого из них. У меня всё было готово. А ты всё испортил. Ты испортил всё!","Я собиралась убить каждого из них. У меня всё было готово. А ты всё испортил. Ты испортил всё!","Я собиралась убить каждого из них. У меня всё было готово. А ты всё испортил. Ты испортил всё!"],["He takes a defensive stance, eyes hardening. ","Он принимает оборонительную позу, взгляд твердеет.","Он принимает оборонительную позу, взгляд твердеет.","Он принимает оборонительную позу, взгляд твердеет.","Он принимает оборонительную позу, взгляд твердеет."],["Hey, I didn’t know you had that place rigged to explode. Maybe next time, leave a sign.","Эй, я не знал, что это место заминировано. В следующий раз оставь табличку.","Эй, я не знал, что это место заминировано. В следующий раз оставь табличку.","Эй, я не знал, что это место заминировано. В следующий раз оставь табличку.","Эй, я не знал, что это место заминировано. В следующий раз оставь табличку."],["You glare back at him.","Ты сверлишь его взглядом.","Ты сверлишь его взглядом.","Ты сверлишь его взглядом.","Ты сверлишь его взглядом."],["Leave, outsider, before you mess things up even further. It’s not safe here.","Уходи, чужак, пока не наделал ещё больше бед. Здесь опасно.","Уходи, чужак, пока не наделал ещё больше бед. Здесь опасно.","Уходи, чужак, пока не наделал ещё больше бед. Здесь опасно.","Уходи, чужак, пока не наделал ещё больше бед. Здесь опасно."],["He narrows his eyes, looking at you with a calm that only makes your frustration flare hotter.","Он прищуривается и смотрит на тебя с таким спокойствием, что твоя злость лишь сильнее разгорается.","Он прищуривается и смотрит на тебя с таким спокойствием, что твоя злость лишь сильнее разгорается.","Он прищуривается и смотрит на тебя с таким спокойствием, что твоя злость лишь сильнее разгорается.","Он прищуривается и смотрит на тебя с таким спокойствием, что твоя злость лишь сильнее разгорается."],["Not for me. For you. You’re going to get yourself killed if you keep this up.","Не для меня. Для тебя. Ты убьёшь себя, если продолжишь в том же духе.","Не для меня. Для тебя. Ты убьёшь себя, если продолжишь в том же духе.","Не для меня. Для тебя. Ты убьёшь себя, если продолжишь в том же духе.","Не для меня. Для тебя. Ты убьёшь себя, если продолжишь в том же духе."],["Excuse me? You’re the one who almost got yourself killed back there.","Прошу прощения? Это ты чуть не погиб там.","Прошу прощения? Это ты чуть не погиб там.","Прошу прощения? Это ты чуть не погиб там.","Прошу прощения? Это ты чуть не погиб там."],["I’m trained for this. I can handle it.","Я обучен таким вещам. Справлюсь.","Я обучен таким вещам. Справлюсь.","Я обучен таким вещам. Справлюсь.","Я обучен таким вещам. Справлюсь."],["You don’t know these things like I do. They lure you with their scent.","Ты не знаешь этих тварей так, как я. Они заманивают запахом.","Ты не знаешь этих тварей так, как я. Они заманивают запахом.","Ты не знаешь этих тварей так, как я. Они заманивают запахом.","Ты не знаешь этих тварей так, как я. Они заманивают запахом."],["You want to get to the lab now? Go ahead. But you’ll end up like everyone else who’s tried — dead.","Хочешь попасть в лабораторию прямо сейчас? Пожалуйста. Но кончишь так же, как все, кто пытался, — мёртвым.","Хочешь попасть в лабораторию прямо сейчас? Пожалуйста. Но кончишь так же, как все, кто пытался, — мёртвым.","Хочешь попасть в лабораторию прямо сейчас? Пожалуйста. Но кончишь так же, как все, кто пытался, — мёртвым.","Хочешь попасть в лабораторию прямо сейчас? Пожалуйста. Но кончишь так же, как все, кто пытался, — мёртвым."],["He pauses, and for the first time, you see his expression soften slightly as he studies you. ","Он замолкает, и впервые его лицо слегка смягчается, пока он изучает тебя.","Он замолкает, и впервые его лицо слегка смягчается, пока он изучает тебя.","Он замолкает, и впервые его лицо слегка смягчается, пока он изучает тебя.","Он замолкает, и впервые его лицо слегка смягчается, пока он изучает тебя."],["Did you see a team come through here?","Ты не видела, чтобы здесь проходила команда?","Ты не видела, чтобы здесь проходила команда?","Ты не видела, чтобы здесь проходила команда?","Ты не видела, чтобы здесь проходила команда?"],["A lot of people come through here. They go to the lab, they get what they want, and they leave us to our fate.","Здесь проходит много людей. Они идут в лабораторию, берут, что им нужно, и бросают нас на произвол судьбы.","Здесь проходит много людей. Они идут в лабораторию, берут, что им нужно, и бросают нас на произвол судьбы.","Здесь проходит много людей. Они идут в лабораторию, берут, что им нужно, и бросают нас на произвол судьбы.","Здесь проходит много людей. Они идут в лабораторию, берут, что им нужно, и бросают нас на произвол судьбы."],["Or they go and never come back. Whoever you’re looking for — they’re probably dead. Or worse.","Или идут туда и не возвращаются. Кого бы ты ни искал — они, скорее всего, мертвы. Или хуже.","Или идут туда и не возвращаются. Кого бы ты ни искал — они, скорее всего, мертвы. Или хуже.","Или идут туда и не возвращаются. Кого бы ты ни искал — они, скорее всего, мертвы. Или хуже.","Или идут туда и не возвращаются. Кого бы ты ни искал — они, скорее всего, мертвы. Или хуже."],["The man looks back toward the forest, his expression turning somber, thoughtful.","Мужчина оглядывается на лес; лицо мрачнеет, становится задумчивым.","Мужчина оглядывается на лес; лицо мрачнеет, становится задумчивым.","Мужчина оглядывается на лес; лицо мрачнеет, становится задумчивым.","Мужчина оглядывается на лес; лицо мрачнеет, становится задумчивым."],["I need to go to the lab and figure out what happened to them. I’m not leaving until I do.","Мне нужно попасть в лабораторию и выяснить, что с ними случилось. Я не уйду, пока не узнаю.","Мне нужно попасть в лабораторию и выяснить, что с ними случилось. Я не уйду, пока не узнаю.","Мне нужно попасть в лабораторию и выяснить, что с ними случилось. Я не уйду, пока не узнаю.","Мне нужно попасть в лабораторию и выяснить, что с ними случилось. Я не уйду, пока не узнаю."],["You shake your head, unsurprised. Of course. They’re all the same. ","Ты качаешь головой, не удивляясь. Конечно. Все они одинаковые.","Ты качаешь головой, не удивляясь. Конечно. Все они одинаковые.","Ты качаешь головой, не удивляясь. Конечно. Все они одинаковые.","Ты качаешь головой, не удивляясь. Конечно. Все они одинаковые."],["Good luck. You'll need it.","Удачи. Она тебе понадобится.","Удачи. Она тебе понадобится.","Удачи. Она тебе понадобится.","Удачи. Она тебе понадобится."],["Without waiting for a response, you turn and march away, ignoring the ache in your chest. You’ll have to start all over again — rebuild, rearm.","Не дожидаясь ответа, ты разворачиваешься и уходишь, не обращая внимания на боль в груди. Придётся начинать с нуля — отстраивать всё заново, снова вооружаться.","Не дожидаясь ответа, ты разворачиваешься и уходишь, не обращая внимания на боль в груди. Придётся начинать с нуля — отстраивать всё заново, снова вооружаться.","Не дожидаясь ответа, ты разворачиваешься и уходишь, не обращая внимания на боль в груди. Придётся начинать с нуля — отстраивать всё заново, снова вооружаться.","Не дожидаясь ответа, ты разворачиваешься и уходишь, не обращая внимания на боль в груди. Придётся начинать с нуля — отстраивать всё заново, снова вооружаться."],["Your hand finds the pendant resting against your chest. You grip it tightly, letting the familiar shape press into your skin.","Рука находит подвеску на груди. Ты крепко сжимаешь её, чувствуя, как знакомая форма впивается в кожу.","Рука находит подвеску на груди. Ты крепко сжимаешь её, чувствуя, как знакомая форма впивается в кожу.","Рука находит подвеску на груди. Ты крепко сжимаешь её, чувствуя, как знакомая форма впивается в кожу.","Рука находит подвеску на груди. Ты крепко сжимаешь её, чувствуя, как знакомая форма впивается в кожу."],["I’m sorry.","Прости.","Прости.","Прости.","Прости."],["You storm back to the house, slamming the door behind you.","Ты врываешься в дом и с грохотом захлопываешь дверь.","Ты врываешься в дом и с грохотом захлопываешь дверь.","Ты врываешься в дом и с грохотом захлопываешь дверь.","Ты врываешься в дом и с грохотом захлопываешь дверь."],["The gear drops from your hands, but you barely notice. All you can think about is him — the arrogant outsider with his stoic face.","Снаряжение выпадает из рук, но ты почти не замечаешь этого. Все мысли — о нём. О самоуверенном чужаке с непроницаемым лицом.","Снаряжение выпадает из рук, но ты почти не замечаешь этого. Все мысли — о нём. О самоуверенном чужаке с непроницаемым лицом.","Снаряжение выпадает из рук, но ты почти не замечаешь этого. Все мысли — о нём. О самоуверенном чужаке с непроницаемым лицом.","Снаряжение выпадает из рук, но ты почти не замечаешь этого. Все мысли — о нём. О самоуверенном чужаке с непроницаемым лицом."],["You grit your teeth. He’s going to get himself killed. You know it. He doesn’t even have a mask. The second he gets close to the lab, he’s as good as dead.","Ты стискиваешь зубы. Он погибнет. Ты знаешь это. У него даже маски нет. Стоит ему приблизиться к лаборатории — и ему конец.","Ты стискиваешь зубы. Он погибнет. Ты знаешь это. У него даже маски нет. Стоит ему приблизиться к лаборатории — и ему конец.","Ты стискиваешь зубы. Он погибнет. Ты знаешь это. У него даже маски нет. Стоит ему приблизиться к лаборатории — и ему конец.","Ты стискиваешь зубы. Он погибнет. Ты знаешь это. У него даже маски нет. Стоит ему приблизиться к лаборатории — и ему конец."],["You told him to leave, warned him what was out there. If he dies, that’s on him. You owe him nothing. He ruined your plan, your final chance at saving the rest of this town.","Ты велела ему уходить, предупредила, что там. Если он умрёт, это будет на нём. Ты ему ничего не должна. Он разрушил твой план — последний шанс спасти остатки этого города.","Ты велела ему уходить, предупредила, что там. Если он умрёт, это будет на нём. Ты ему ничего не должна. Он разрушил твой план — последний шанс спасти остатки этого города.","Ты велела ему уходить, предупредила, что там. Если он умрёт, это будет на нём. Ты ему ничего не должна. Он разрушил твой план — последний шанс спасти остатки этого города.","Ты велела ему уходить, предупредила, что там. Если он умрёт, это будет на нём. Ты ему ничего не должна. Он разрушил твой план — последний шанс спасти остатки этого города."],["But the thought of him stumbling into the lab, clueless, gnaws at you. Why the hell do you care? You shouldn’t.","Но мысль о том, что он вслепую бредёт в лабораторию, не даёт покоя. Какого чёрта тебя это волнует? Не должно.","Но мысль о том, что он вслепую бредёт в лабораторию, не даёт покоя. Какого чёрта тебя это волнует? Не должно.","Но мысль о том, что он вслепую бредёт в лабораторию, не даёт покоя. Какого чёрта тебя это волнует? Не должно.","Но мысль о том, что он вслепую бредёт в лабораторию, не даёт покоя. Какого чёрта тебя это волнует? Не должно."],["You don’t.","Не волнует.","Не волнует.","Не волнует.","Не волнует."],["skin_choice","skin_choice","skin_choice","skin_choice","skin_choice"],["Linear","Linear","Linear","Linear","Linear"],["Unchanged","Unchanged","Unchanged","Unchanged","Unchanged"],["Choose a skin color:","Выбери цв
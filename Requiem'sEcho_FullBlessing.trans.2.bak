st wh = this.helpAreaHeight();\\nreturn new Rectangle(wx, wy, ww, wh);\"",""],["\"const rows = 1;\\nconst width = this.mainCommandWidth();\\nconst height = this.calcWindowHeight(rows, true);\\nconst x = Graphics.boxWidth - width;\\nconst y = this.mainAreaTop();\\nreturn new Rectangle(x, y, width, height);\"",""],["\"const x = 0;\\nconst y = this.mainAreaTop();\\nconst rows = 1;\\nconst width = this._goldWindow.x;\\nconst height = this.calcWindowHeight(rows, true);\\nreturn new Rectangle(x, y, width, height);\"",""],["\"const x = 0;\\nconst y = this._commandWindow.y + this._commandWindow.height;\\nconst width = Graphics.boxWidth;\\nconst height = this.mainAreaHeight() - this._commandWindow.height;\\nreturn new Rectangle(x, y, width, height);\"",""],["\"const x = 0;\\nconst y = this._dummyWindow.y;\\nconst width = Graphics.boxWidth - this.statusWidth();\\nconst height = this._dummyWindow.height;\\nreturn new Rectangle(x, y, width, height);\"",""],["\"const width = this.statusWidth();\\nconst height = this._dummyWindow.height;\\nconst x = Graphics.boxWidth - width;\\nconst y = this._dummyWindow.y;\\nreturn new Rectangle(x, y, width, height);\"",""],["\"const x = 0;\\nconst y = this._dummyWindow.y;\\nconst rows = 1;\\nconst width = Graphics.boxWidth;\\nconst height = this.calcWindowHeight(rows, true);\\nreturn new Rectangle(x, y, width, height);\"",""],["\"const x = 0;\\nconst y = this._categoryWindow.y + this._categoryWindow.height;\\nconst width = Graphics.boxWidth;\\nconst height =\\n    this.mainAreaHeight() -\\n    this._commandWindow.height -\\n    this._categoryWindow.height;\\nreturn new Rectangle(x, y, width, height);\"",""],["\"const rows = 9;\\nconst inputWindowHeight = this.calcWindowHeight(rows, true);\\nconst padding = $gameSystem.windowPadding();\\nconst width = 600;\\nconst height = Math.min(ImageManager.faceHeight + padding * 2, this.mainAreaHeight() - inputWindowHeight);\\nconst x = (Graphics.boxWidth - width) / 2;\\nconst y = (this.mainAreaHeight() - (height + inputWindowHeight)) / 2 + this.mainAreaTop();\\nreturn new Rectangle(x, y, width, height);\"",""],["\"const x = this._editWindow.x;\\nconst y = this._editWindow.y + this._editWindow.height;\\nconst rows = 9;\\nconst width = this._editWindow.width;\\nconst height = this.calcWindowHeight(rows, true);\\nreturn new Rectangle(x, y, width, height);\"",""],["ATK",""],["DEF",""],["MAT",""],["MDF",""],["AGI",""],["LUK",""],["MaxHP",""],["MaxMP",""],["\"// Determine the variables used in this calculation.\\nlet paramId = arguments[0];\\nlet base = this.paramBase(paramId);\\nlet plus = this.paramPlus(paramId);\\nlet paramRate = this.paramRate(paramId);\\nlet buffRate = this.paramBuffRate(paramId);\\nlet flatBonus = this.paramFlatBonus(paramId);\\n\\n// Formula to determine total parameter value.\\nlet value = (base + plus) * paramRate * buffRate + flatBonus;\\n\\n// Determine the limits\\nconst maxValue = this.paramMax(paramId);\\nconst minValue = this.paramMin(paramId);\\n\\n// Final value\\nreturn Math.round(value.clamp(minValue, maxValue));\"",""],["\"// Determine the variables used in this calculation.\\nlet xparamId = arguments[0];\\nlet base = this.traitsSum(Game_BattlerBase.TRAIT_XPARAM, xparamId);\\nlet plus = this.xparamPlus(xparamId);\\nlet paramRate = this.xparamRate(xparamId);\\nlet flatBonus = this.xparamFlatBonus(xparamId);\\n\\n// Formula to determine total parameter value.\\nlet value = (base + plus) * paramRate + flatBonus;\\n\\n// Final value\\nreturn value;\"",""],["Hit",""],["Evasion",""],["Critical Rate",""],["Critical Evade",""],["Magic Evade",""],["Magic Reflect",""],["Counter",""],["HP Regen",""],["MP Regen",""],["TP Regen",""],["\"// Determine the variables used in this calculation.\\nlet sparamId = arguments[0];\\nlet base = this.traitsPi(Game_BattlerBase.TRAIT_SPARAM, sparamId);\\nlet plus = this.sparamPlus(sparamId);\\nlet paramRate = this.sparamRate(sparamId);\\nlet flatBonus = this.sparamFlatBonus(sparamId);\\n\\n// Formula to determine total parameter value.\\nlet value = (base + plus) * paramRate + flatBonus;\\n\\n// Final value\\nreturn value;\"",""],["Aggro",""],["Guard",""],["Recovery",""],["Item Effect",""],["MP Cost",""],["TP Charge",""],["Physical DMG",""],["Magical DMG",""],["Floor DMG",""],["EXP Gain",""],["Strength",""],["str",""],["integer",""],["\"// Declare Constants\\nconst user = this;\\n\\n// Calculations\\nreturn (user.atk * 0.75) + (user.def * 0.25);\"",""],["Dexterity",""],["dex",""],["\"// Declare Constants\\nconst user = this;\\n\\n// Calculations\\nreturn (user.agi * 0.75) + (user.atk * 0.25);\"",""],["Constitution",""],["con",""],["\"// Declare Constants\\nconst user = this;\\n\\n// Calculations\\nreturn (user.def * 0.75) + (user.mdf * 0.25);\"",""],["Intelligence",""],["int",""],["\"// Declare Constants\\nconst user = this;\\n\\n// Calculations\\nreturn (user.mat * 0.75) + (user.mdf * 0.25);\"",""],["Wisdom",""],["wis",""],["\"// Declare Constants\\nconst user = this;\\n\\n// Calculations\\nreturn (user.mdf * 0.75) + (user.luk * 0.25);\"",""],["Charisma",""],["cha",""],["\"// Declare Constants\\nconst user = this;\\n\\n// Calculations\\nreturn (user.luk * 0.75) + (user.agi * 0.25);\"",""],["random",""],["\"// Calculation\\nthis.x += Math.round($gameScreen.shake());\"",""],["\"// Calculation\\n// Original Formula by Aries of Sheratan\\nconst power = $gameScreen._shakePower * 0.75;\\nconst speed = $gameScreen._shakeSpeed * 0.60;\\nconst duration = $gameScreen._shakeDuration;\\nthis.x += Math.round(Math.randomInt(power) - Math.randomInt(speed)) * (Math.min(duration, 30) * 0.5);\\nthis.y += Math.round(Math.randomInt(power) - Math.randomInt(speed)) * (Math.min(duration, 30) * 0.5);\"",""],["\"// Calculation\\n// Original Formula by Aries of Sheratan\\nconst power = $gameScreen._shakePower * 0.75;\\nconst speed = $gameScreen._shakeSpeed * 0.60;\\nconst duration = $gameScreen._shakeDuration;\\nthis.x += Math.round(Math.randomInt(power) - Math.randomInt(speed)) * (Math.min(duration, 30) * 0.5);\"",""],["\"// Calculation\\n// Original Formula by Aries of Sheratan\\nconst power = $gameScreen._shakePower * 0.75;\\nconst speed = $gameScreen._shakeSpeed * 0.60;\\nconst duration = $gameScreen._shakeDuration;\\nthis.y += Math.round(Math.randomInt(power) - Math.randomInt(speed)) * (Math.min(duration, 30) * 0.5);\"",""],["newGame",""],["\"return TextManager.newGame;\"",""],["\"SceneManager._scene.commandNewGame();\"",""],["continue",""],["\"return TextManager.continue_;\"",""],["\"return DataManager.isAnySavefileExists();\"",""],["\"SceneManager._scene.commandContinue();\"",""],["options",""],["\"return TextManager.options;\"",""],["\"SceneManager._scene.commandOptions();\"",""],["shutdown",""],["\"return TextManager.gameEnd;\"",""],["\"return Utils.isNwjs();\"",""],["\"SceneManager.exit();\\n\\n// Note!\\n// Do NOT use this command with mobile devices or\\n// browser games. All it does is cause the game to\\n// display a blank, black canvas which the player\\n// is unable to do anything with. It does NOT force\\n// close the browser tab nor the app.\"",""],["\"const rect = arguments[0];\\nconst c1 = ColorManager.itemBackColor1();\\nconst c2 = ColorManager.itemBackColor2();\\nconst x = rect.x;\\nconst y = rect.y;\\nconst w = rect.width;\\nconst h = rect.height;\\nthis.contentsBack.gradientFillRect(x, y, w, h, c1, c2, true);\\nthis.contentsBack.strokeRect(x, y, w, h, c1);\"",""],["Example",""],["\"// Insert this as a function anywhere you can input code\\n// such as Script Calls or Conditional Branch Scripts.\\n\\n// Process Code\\nreturn 'Example';\"",""],["Bad  Code  Name",""],["\"// If a function name has spaces in them, the spaces will\\n// be removed. \\\"Bad  Code  Name\\\" becomes \\\"BadeCodeName\\\".\\n\\n// Process Code\\nOhNoItsBadCode()\\n\\n// If a function has bad code, a fail safe will catch the\\n// error and display it in the console.\"",""],["RandomNumber",""],["\"// This generates a random number from 0 to itself.\\n// Example: RandomNumber(10)\\n\\n// Process Code\\nconst number = (arguments[0] || 0) + 1;\\nreturn Math.floor(number * Math.random());\"",""],["RandomBetween",""],["\"// This generates a random number between two arguments.\\n// Example: RandomBetween(5, 10)\\n\\n// Process Code\\nlet min = Math.min(arguments[0] || 0, arguments[1] || 0);\\nlet max = Math.max(arguments[0] || 0, arguments[1] || 0);\\nreturn Math.floor(Math.random() * (max - min + 1) + min);\"",""],["RandomFrom",""],["\"// Selects a number from the list of inserted numbers.\\n// Example: RandomFrom(5, 10, 15, 20)\\n\\n// Process Code\\nreturn arguments[Math.randomInt(arguments.length)];\"",""],[".webm",""],["title",""],["system/Splash",""],["left",""],["Default",""],["Navigate using the arrow keys.\nPress \\c[4]Z\\c[0] or \\c[4]Enter\\c[0] to select, \\c[4]X\\c[0] or \\c[4]Esc\\c[0] to go back.",""],["Select an item category!\nPress \\c[4]X\\c[0] or \\c[4]Esc\\c[0] to go back.",""],["No items to see here.\nPress \\c[4]X\\c[0] or \\c[4]Esc\\c[0] to go back.",""],["Select a skill type!\nPress \\c[4]X\\c[0] or \\c[4]Esc\\c[0] to go back.",""],["No skills to see here.\nPress \\c[4]X\\c[0] or \\c[4]Esc\\c[0] to go back.",""],["This equip slot is empty.\nPress \\c[4]Z\\c[0] or \\c[4]Enter\\c[0] to choose an item to equip!",""],["You have nothing to equip in this slot.\nPress \\c[4]X\\c[0] or \\c[4]Esc\\c[0] to go back.",""],["There's nothing here to purchase.\nPress \\c[4]X\\c[0] or \\c[4]Esc\\c[0] to go back.",""],["You have no items of this type to sell.\nPress \\c[4]X\\c[0] or \\c[4]Esc\\c[0] to go back.",""],["No Swap",""],["None",""],["hiddenItemA",""],["hiddenItemB",""],["Scene_Skill",""],["\"this.anchor.x = 0.5;\\nconst scale = 1.25;\\nthis.scale.x = this.scale.y = scale;\\nthis.x = Graphics.width;\\nthis.y = Graphics.height - (this.bitmap.height * Math.abs(scale));\\nthis._targetX = Graphics.width * 3 / 4;\\nthis._targetY = Graphics.height - (this.bitmap.height * Math.abs(scale));\\nthis._duration = 10;\\nthis.opacity = 0;\"",""],["item",""],["\"return TextManager.item;\"",""],["\"return this.needsCommand(\\\"item\\\");\"",""],["\"return this.areMainCommandsEnabled();\"",""],["\"SceneManager._scene.commandItem();\"",""],["\"const ext = arguments[0];\"",""],["classChange",""],["\"return TextManager.classChangeMenuCommand;\"",""],["\"return Imported.VisuMZ_2_ClassChangeSystem &&\\n    this.isClassChangeCommandVisible();\"",""],["\"return this.areMainCommandsEnabled() &&\\n    this.isClassChangeCommandEnabled();\"",""],["\"SceneManager._scene.commandPersonal();\"",""],["\"SceneManager.push(Scene_ClassChange);\"",""],["skill",""],["\"return TextManager.skill;\"",""],["\"return this.needsCommand(\\\"skill\\\");\"",""],["\"SceneManager.push(Scene_Skill);\"",""],["equip",""],["\"return TextManager.equip;\"",""],["\"return this.needsCommand(\\\"equip\\\");\"",""],["\"SceneManager.push(Scene_Equip);\"",""],["status",""],["\"return TextManager.status;\"",""],["\"return this.needsCommand(\\\"status\\\");\"",""],["\"SceneManager.push(Scene_Status);\"",""],["itemCrafting",""],["\"return TextManager.ItemCraftingMenuCommand;\"",""],["\"return Imported.VisuMZ_2_ItemCraftingSys &&\\n    this.isItemCraftingCommandVisible();\"",""],["\"return this.isItemCraftingCommandEnabled();\"",""],["\"SceneManager._scene.commandItemCrafting();\"",""],["subcategory",""],["Datalog",""],["\"return 'Text';\"",""],["\"return this.isSubcategoryVisible(arguments[1]);\"",""],["\"// This becomes the subcategory name. Case-sensitive.\\n\\nreturn 'datalog';\"",""],["\"const ext = arguments[0];\\nthis.setSubcategory(ext);\"",""],["quest",""],["datalog",""],["\"return TextManager.questCommandName;\"",""],["\"return Imported.VisuMZ_2_QuestSystem &&\\n    this.isQuestCommandVisible();\"",""],["\"return this.isQuestCommandEnabled();\"",""],["\"SceneManager._scene.commandQuest();\"",""],["bestiary",""],["\"return TextManager.BestiaryMenuCommand;\"",""],["\"return Imported.VisuMZ_2_Bestiary &&\\n    this.isBestiaryCommandVisible();\"",""],["\"return this.isBestiaryCommandEnabled();\"",""],["\"SceneManager._scene.commandBestiary();\"",""],["tutorialList",""],["\"return TextManager.tutorial.menuCmd;\"",""],["\"return Imported.VisuMZ_2_TutorialPanelSys &&\\n    this.isTutorialListCommandVisible();\"",""],["\"return this.isTutorialListCommandEnabled();\"",""],["\"SceneManager._scene.commandTutorialList();\"",""],["messageLog",""],["\"return TextManager.MessageLogMenuCommand;\"",""],["\"return Imported.VisuMZ_3_MessageLog &&\\n    this.isMessageLogCommandVisible();\"",""],["\"return this.isMessageLogCommandEnabled();\"",""],["\"SceneManager._scene.commandMessageLog();\"",""],["combatLog",""],["\"return TextManager.combatLog_BattleCmd_Name;\"",""],["\"return Imported.VisuMZ_4_CombatLog &&\\n    this.isCombatLogCommandVisible();\"",""],["\"return this.isCombatLogCommandEnabled();\"",""],["\"SceneManager._scene.commandCombatLog();\"",""],["cgGallery",""],["\"return TextManager.cgGalleryMenuCommand;\"",""],["\"return Imported.VisuMZ_4_CGGallery &&\\n    this.isCgGalleryCommandVisible();\"",""],["\"return this.isCgGalleryCommandEnabled();\"",""],["\"SceneManager._scene.commandCgGallery();\"",""],["creditsPage",""],["\"return TextManager.CreditsPageMenuCommand;\"",""],["\"return Imported.VisuMZ_4_CreditsPage &&\\n    this.isCreditsPageCommandVisible();\"",""],["\"return this.isCreditsPageCommandEnabled();\"",""],["\"SceneManager._scene.commandCreditsPage();\"",""],["patchNotes",""],["\"return TextManager.PatchNotesMenuCommand;\"",""],["\"return Imported.VisuMZ_4_PatchNotes &&\\n    this.isPatchNotesCommandVisible();\"",""],["\"return this.isPatchNotesCommandEnabled();\"",""],["\"SceneManager._scene.commandPatchNotes();\"",""],["formation",""],["\"return TextManager.formation;\"",""],["\"return this.needsCommand(\\\"formation\\\");\"",""],["\"return this.isFormationEnabled();\"",""],["\"SceneManager._scene.commandFormation();\"",""],["battleGridTactics",""],["\"return TextManager.BattleGridTactic
$gameSystem.onBeforeSave();    "]},{"code":655,"indent":0,"parameters":["DataManager.saveGame(slotId).then(() => {"]},{"code":655,"indent":0,"parameters":["        console.log(\"Игра успешно сохранена в слот \" + slotId);"]},{"code":655,"indent":0,"parameters":["    }).catch((error) => {"]},{"code":655,"indent":0,"parameters":["        console.error(\"Не удалось сохранить игру:\", error);"]},{"code":655,"indent":0,"parameters":["    });"]},{"code":655,"indent":0,"parameters":["}"]},{"code":655,"indent":0,"parameters":[""]},{"code":655,"indent":0,"parameters":["saveGameInSlot(1);"]},{"code":357,"indent":0,"parameters":["VisuMZ_1_SaveCore","SaveDescription","Save: Set Description",{"Text:str":"Глава 1: Финальная охота"}]},{"code":657,"indent":0,"parameters":["Text = Глава 1: Финальная охота"]},{"code":357,"indent":0,"parameters":["VisuMZ_1_SaveCore","SavePicture","Save: Set Picture",{"Filename:str":"forest_fire"}]},{"code":657,"indent":0,"parameters":["Filename = forest_fire"]},{"code":117,"indent":0,"parameters":[1]},{"code":241,"indent":0,"parameters":[{"name":"Distorted Spiritual Realm","volume":90,"pitch":100,"pan":0}]},{"code":355,"indent":0,"parameters":["AudioManager.fadeInBgm(3)"]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":231,"indent":0,"parameters":[1,"house",1,0,640,270,100,100,0,0]},{"code":232,"indent":0,"parameters":[1,0,1,0,640,270,100,100,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты выходишь из ветхого дома, и дверь со скрипом захлопывается у тебя за спиной."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Снаряжение оттягивает плечи, но давит не только оно — давят годы."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты готовилась к этой ночи дольше, чем готова признать. Каждый шаг даётся тяжело."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Но останавливаться нельзя. Только не сейчас."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Твой взгляд задерживается на окнах. Внутри остались тени прежней жизни — теперь она кажется призраком."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Фотографии на стенах, покрытые пылью следы забытых увлечений. Когда-то у тебя были другие мечты."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Но они давно рассыпались в прах, уступив место единственной, всепоглощающей цели: охоте."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты слышишь это."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Птицы торопливо взмывают в небо. Ты знаешь, что это значит."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Скоро закат."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Пора."]},{"code":232,"indent":0,"parameters":[1,0,1,0,640,270,100,100,0,0,60,true,0]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":222,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[2,"forest_fire",1,0,640,270,100,100,0,0]},{"code":232,"indent":0,"parameters":[2,0,1,0,640,270,100,100,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Костёр прорезает сгущающуюся тьму — одинокий маяк среди высоких деревьев."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты заканчиваешь натягивать колючую проволоку от дерева к дереву, замыкая вокруг поляны жестокий периметр — ловушку, из которой нет выхода."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты смотришь на горизонт: солнце опускается всё ниже и скрывается за деревьями, а длинные тени тянутся по земле, словно тёмные пальцы, вцепляющиеся в неё."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Нужно торопиться. Они скоро придут."]},{"code":102,"indent":0,"parameters":[["Расставить растяжки и за пределами поляны","Расставить растяжки только внутри поляны"],-1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"Расставить растяжки и за пределами поляны"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Ты выносишь взрывчатку за пределы поляны, протягивая растяжки по внешнему периметру. Если кто-то из них прорвётся через первую линию обороны, эти ловушки его остановят."]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Сегодня им не уйти."]},{"code":121,"indent":1,"parameters":[24,24,0]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Расставить растяжки только внутри поляны"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Костёр притянет их, как мотыльков на огонь. Если сосредоточить взрывчатку внутри поляны, они окажутся именно там, где тебе нужно, когда ловушка захлопнется."]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Лес погружается в тень, пока ты заканчиваешь с растяжками. Ты удовлетворённо киваешь, но остаётся последний штрих."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Достав нож, ты резким движением рассекаешь ладонь, и кровь капает на землю. В меркнущем свете она кажется тёмной, почти чёрной; почва жадно впитывает её, стоит ей упасть."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты перевязываешь рану полоской ткани и затягиваешь потуже, пока боль не превращается в глухую пульсацию."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Обычно ты так не делаешь. Живые и без того притягивают их."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Но сегодня всё иначе. Тебе нужно, чтобы пришли все до единого."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Раньше ты пыталась выследить их до логова, но туннели слишком извилистые, глубокие и запутанные."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Поэтому теперь ты выманиваешь их сама — так же, как они заманивают людей, используя свой запах, чтобы вести их на смерть."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Это жестокое состязание охотников, и ты намерена остаться последней, кто устоит на ногах."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты натягиваешь противогаз — резина холодная и туго стягивает кожу — и укрываешься за деревом."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Острое чувство одиночества вонзается в тебя. Как бы ты хотела не делать этого одна, но оставшиеся горожане… изменились."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Одурманенные тем, что выделяют эти твари, они стали кем-то другим. Пустыми оболочками. Ты должна положить этому конец, пока они не принесли в жертву кого-то ещё."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Последние лучи солнца гаснут, и наступает густая, удушающая тишина. Лес будто затаил дыхание, чувствуя, что надвигается."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Руки слегка дрожат, пока ты сжимаешь огнемёт: металл холодный, хотя ладони мокры от пота."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Стоит существам ступить на поляну — взрывчатка разнесёт первую волну, а колючая проволока задержит остальных."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Потом хлынут новые. Ты будешь выкашивать их волну за волной, пока не останется один пепел."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["После стольких лет охоты всё решится этой ночью. Либо ты убьёшь их всех, либо они наконец заберут тебя."]},{"code":232,"indent":0,"parameters":[2,0,1,0,640,270,100,100,0,0,60,true,0]},{"code":242,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[3,"city",1,0,640,270,100,100,0,0]},{"code":232,"indent":0,"parameters":[3,0,1,0,640,270,100,100,255,0,60,true,0]},{"code":241,"indent":0,"parameters":[{"name":"Lingering memories","volume":90,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[60]},{"code":117,"indent":0,"parameters":[3]},{"code":230,"indent":0,"parameters":[80]},{"code":355,"indent":0,"parameters":["CreateSAnim(\"leon\", \"leon\", 659, 730).bindBelowWindows().setScale(0.5)"]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").fadeIn(60)"]},{"code":230,"indent":0,"parameters":[10]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"normal\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Леон въезжает в город. Улицы мертвы и пусты — очередной город-призрак, наследие Umbrella."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Окна заколочены, двери забиты гвоздями, будто жители пытаются не впустить что-то. Или не выпустить."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он гадает, сколько таких мест ещё осталось. Он думал, что после падения Umbrella с ними покончено. Но время от времени всплывает новое."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он чувствует это — покалывание в затылке."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Проезжая мимо, он бросает взгляд на разбитое окно, но там ничего нет. Только тени, ползущие вместе с последним светом дня."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Леон"]},{"code":401,"indent":0,"parameters":["Терпеть не могу, когда соседи ведут себя так тихо."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Солнце клонится к закату, окрашивая небо в оранжевые и красные тона. Он вздыхает, барабаня пальцами по рулю."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он хотел приехать раньше, но брифинг затянулся, а местные копы оказались не слишком полезны."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Когда он спросил, не замечали ли они чего-нибудь странного, все посмотрели на него одинаково пустым взглядом. Нет, ничего, сэр."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он не уверен, лгут они, ничего не знают или просто напуганы."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Навигатор мигает, указывая путь к лаборатории на окраине. Она спрятана в лесу, на холме."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Проще простого, верно? Найти пропавшую команду, осмотреть лабораторию и убраться."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ничего сложного."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Вот только так не бывает никогда."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").fadeOut(30)"]},{"code":232,"indent":0,"parameters":[3,0,1,0,640,270,100,100,0,0,60,true,0]},{"code":231,"indent":0,"parameters":[4,"forest_night",1,0,640,270,100,100,0,0]},{"code":232,"indent":0,"parameters":[4,0,1,0,640,270,100,100,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Леон глушит двигатель и спрыгивает с мотоцикла; тишина смыкается вокруг него. Воздух кажется… неправильным. Слишком неподвижным — той неподвижностью, что забирается под кожу."]},{"code":355,"indent":0,"parameters":["CreateSAnim(\"leon\", \"leon\", 659, 730).bindBelowWindows().setScale(0.5)"]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").fadeIn(60)"]},{"code":230,"indent":0,"parameters":[10]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"normal\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Леон"]},{"code":401,"indent":0,"parameters":["Ладно, Леон. Очередной жуткий лес. Что может пойти не так?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Дальше он идёт пешком. Земля мягкая под ботинками, сухие листья глушат шаги. Рука замирает у пистолета. Тропа узкая, заросшая, а тени в меркнущем свете вытягиваются всё длиннее."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Вдруг он замечает сквозь деревья мерцающий свет."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Леон останавливается и щурится. Здесь кто-то есть. Может, пропавшая команда. А может, что-то другое."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он сходит с тропы и пригибается за деревом, наблюдая, как в темноте пульсирует костёр."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Леон"]},{"code":401,"indent":0,"parameters":["Тот, кто здесь заночевал, явно не силён в создании уюта."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["И тут до него долетает слабый запах — сладкий, приторный, почти цветочный."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"angry\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он крепче сжимает пистолет, мышцы напрягаются: срабатывают инстинкты. Это не привычная вонь гниющих Б.О.О. Это… другое. Неправильное. Что бы ни ждало впереди, оно будто зовёт его."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Последние отблески солнца тонут за деревьями. Тьма смыкается, и свет снова дрожит, отбрасывая жуткие тени, которые словно тянутся к нему."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он медленно и уверенно движется вперёд, все чувства на пределе. Он проходил через это и раньше — чаще, чем хотел бы помнить."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Что бы ни поджидало во тьме, застать его врасплох ему не удастся."]},{"code":111,"indent":0,"parameters":[0,24,0]},{"code":242,"indent":1,"parameters":[2]},{"code":355,"indent":1,"parameters":["SAnim(\"leon\").addAnimation(\"pls_open\", true, 0, 0.5)"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Голова Леона наливается туманом, чувства притупляются. Теперь он видит огонь — огромный костёр, освещающий ночь."]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Заметив просвет, он делает шаг вперёд, но что-то касается его груди — проволока."]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Тихий писк доносится до него секундой позже, чем следовало."]},{"code":355,"indent":1,"parameters":["SAnim(\"leon\").addAnimation(\"surp\", true, 0, 0.5)"]},{"code":101,"indent":1,"parameters":["",0,0,2,"Леон"]},{"code":401,"indent":1,"parameters":["Похоже, я сам на это напросился."]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Растяжка срабатывает, и оглушительный взрыв разрывает воздух."]},{"code":353,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":355,"indent":1,"parameters":["SAnim(\"leon\").fadeOut(30)"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":232,"indent":0,"parameters":[4,0,1,0,640,270,100,100,0,0,60,true,0]},{"code":242,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[2,"forest_fire",1,0,640,270,100,100,0,0]},{"code":232,"indent":0,"parameters":[2,0,1,0,640,270,100,100,255,0,60,true,0]},{"code":241,"indent":0,"parameters":[{"name":"Autopsy","volume":90,"pitch":100,"pan":0}]},{"code":355,"indent":0,"parameters":["AudioManager.fadeInBgm(3)"]},{"code":230,"indent":0,"parameters":[60]},{"code":117,"indent":0,"parameters":[2]},{"code":230,"indent":0,"parameters":[80]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты вслушиваешься; дыхание запотевает внутри противогаза. Лес кажется душным, каждая тень давит, налитая напряжением."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Резкий скрипучий звук нарушает тишину — хитиновые лапы скребут по сухой коре. Знакомые щелчки и треск, которые ты научилась связывать с этими тварями."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Они здесь."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Сердце колотится, ты выравниваешь дыхание: фильтрованный воздух сух и затхл на губах."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Пальцы крепче смыкаются на огнемёте; ты готовишься подняться из укрытия, каждый мускул натянут."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Но тут что-то мелькает на краю зрения — фигура, скользящая по поляне."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Мужчина."]},{"code":242,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты замираешь и смотришь, как он приближается к твоим ловушкам."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Стой. Неужели он…?"]},{"code":241,"indent":0,"parameters":[{"name":"Thinking Music","volume":90,"pitch":100,"pan":0}]},{"code":355,"indent":0,"parameters":["AudioManager.fadeInBgm(3)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он обезвреживает твои растяжки!"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Пульс срывается в галоп, сердце грохочет в ушах. Не раздумывая, ты бросаешься из укрытия, петляя между ловушками, которые помнишь наизусть."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Ты! Стой!"]},{"code":355,"indent":0,"parameters":["CreateSAnim(\"leon\", \"leon\", 659, 730).bindBelowWindows().setScale(0.5)"]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").fadeIn(60)"]},{"code":230,"indent":0,"parameters":[10]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"normal\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Голос звучит глухо, искажённый маской, но он замирает и оборачивается."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["На долю секунды ты теряешься. Он… не такой, как ты ожидала. Резкие черты, пронзительный взгляд. Привлекательный — до неуместности для этих мест."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Совсем не тот, кого ждёшь встретить в подобном кошмаре."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Твой взгляд падает на его руку — она застыла у пистолета, поза напряжённая и собранная. Точно не гражданский."]},{"code":102,"indent":0,"parameters":[["Какого чёрта ты творишь?","Эти ловушки — мои."],-1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"Какого чёрта ты творишь?"]},{"code":355,"indent":1,"parameters":["SAnim(\"leon\").addAnimation(\"eyebrow\", true, 0, 0.5)"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Он приподнимает бровь, ничуть не смущённый твоим тоном."]},{"code":101,"indent":1,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":1,"parameters":["Эти — твои?"]},{"code":101,"indent":1,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":1,"parameters":["Да."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Эти ловушки — мои."]},{"code":101,"indent":1,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":1,"parameters":["Буду признательна, если ты не станешь в них копаться."]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Он оглядывает разбросанные провода, и на его лице мелькает почти веселье."]},{"code":101,"indent":1,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":1,"parameters":["О. Виноват."]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"normal\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Сколько ты уже обезвредил?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он склоняет голову, обдумывая ответ."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["Ну… несколько."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты тихо ругаешься и сильнее сжимаешь огнемёт. Как же не повезло — какой-то несведущий чужак срывает день, которого ты ждала годами."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["Зачем тебе столько взрывчатки?"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Я охочусь."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"eyebrow\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Его взгляд перемещается на огнемёт в твоих руках, затем на колючую проволоку между деревьями."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["У тебя довольно… нестандартный подход к охоте."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты делаешь глубокий вдох. Не время для этого."]},{"code":242,"indent":0,"parameters":[1]},{"code":241,"indent":0,"parameters":[{"name":"Distorted Spiritual Realm","volume":90,"pitch":100,"pan":0}]},{"code":355,"indent":0,"parameters":["AudioManager.fadeInBgm(3)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Ты ведь не местный, так? Тебе стоит уйти. Немедленно."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты бросаешь взгляд на кромку леса, где чувствуешь движение. Запах уже просачивается — тот самый приторно-сладкий цветочный аромат, что источают эти существа."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"normal\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Маски на нём нет — в глазах уже заметна лёгкая дымка. Долго он не продержится, если они подберутся ближе."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Мужчина качает головой и подступает на шаг."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["Не выйдет. Мне нужно попасть в ту лабораторию, а другого пути нет."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты нервно вертишь огнемёт, разрываясь между любопытством и досадой. Кем бы он ни был, ему нужно убраться отсюда."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Ты понятия не имеешь, что там, в лесу. Возвращайся. Подожди до утра. Что бы ты ни искал в лаборатории — её уже растащили."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Но поступай как знаешь. Только не сейчас."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Знакомый звук эхом разносится по лесу — те же щелчки, тот же тошнотворный скрип. Они приближаются. Он тоже слышит: стойка меняется, глаза сужаются."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"angry\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["На кого именно ты охотишься?"]},{"code":242,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты не успеваешь ответить: на опушке вспыхивают жёлтые глаза. Десятки, мерцающие, как светлячки в темноте; они смещаются, вцепляясь в тебя взглядом."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Их больше, чем ты рассчитывала; вероятно, их привлёк и его запах. Без взрывчатки со всеми не справиться."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Беги."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").fadeOut(30)"]},{"code":241,"indent":0,"parameters":[{"name":"Imitates_Gunfire","volume":90,"pitch":100,"pan":0}]},{"code":355,"indent":0,"parameters":["AudioManager.fadeInBgm(3)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты не ждёшь его ответа. Гремят взрывы, земля дрожит под ногами, но существа прорываются сквозь дым — быстрее, чем ты думала."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты мчишься вперёд, огибая ловушки, петляя в лабиринте проводов и взрывчатки."]},{"code":355,"indent":0,"parameters":["CreateSAnim(\"leon\", \"leon\", 659, 730).bindBelowWindows().setScale(0.5)"]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").fadeIn(60)"]},{"code":230,"indent":0,"parameters":[10]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"angry\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Позади раздаются выстрелы. Ты оглядываешься и видишь его: он стреляет по существам на бегу и каким-то чудом не отстаёт."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Не трать патроны! Их это не убьёт!"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Раздаётся резкий треск, и внезапно в маску просачивается тёплый воздух. Видимо, её пробил осколок."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Теперь ты уязвима, а запасной маски под рукой нет. Остаётся только бежать."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты продираешься сквозь подлесок и выпускаешь огонь назад — волна пламени опаляет воздух. Существа визжат и отшатываются, но не прекращают погоню."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты видишь, как он прицеливается и стреляет в одну из мин, закреплённых на ближайшем дереве."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Взрыв сотрясает поляну, дым застилает всё вокруг, и лес тонет в хаосе."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").fadeOut(30)"]},{"code":232,"indent":0,"parameters":[2,0,1,0,640,270,100,100,0,0,60,true,0]},{"code":242,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[4,"forest_night",1,0,640,270,100,100,0,0]},{"code":232,"indent":0,"parameters":[4,0,1,0,640,270,100,100,255,0,60,true,0]},{"code":241,"indent":0,"parameters":[{"name":"There seems to be no one in this room","volume":90,"pitch":100,"pan":0}]},{"code":355,"indent":0,"parameters":["AudioManager.fadeInBgm(3)"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты бежишь, пока не оказываешься далеко, и, задыхаясь, срываешь испорченную маску."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Прохладный ночной воздух наполняет лёгкие, но ощущается как поражение. Всё, что ты построила, пропало. Ловушки, взрывчатка — всё впустую."]},{"code":355,"indent":0,"parameters":["CreateSAnim(\"leon\", \"leon\", 659, 730).bindBelowWindows().setScale(0.5)"]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").fadeIn(60)"]},{"code":230,"indent":0,"parameters":[10]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"normal\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Мужчина нагоняет тебя и оглядывается на дым и огонь, мерцающие вдали. Пистолет по-прежнему в руке, а сам он выглядит… невозмутимым."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["Знатный фейерверк там получился."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"eyebrow\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он смотрит на тебя, приподняв бровь."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["Что это были за твари? Ты ведь уже сталкивалась с ними?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Кровь закипает, и ты швыряешь сломанную маску на землю."]},{"code":102,"indent":0,"parameters":[["Это твоя вина","Это его вина"],-1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"Это твоя вина"]},{"code":355,"indent":1,"parameters":["SAnim(\"leon\").addAnimation(\"normal\", true, 0, 0.5)"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Тебе надо было идти дальше. Держаться плана и не обращать внимания на чужака. Ярость гаснет, и на её место приходит пустое чувство поражения."]},{"code":101,"indent":1,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":1,"parameters":["Я долго готовилась к этому дню. Я собиралась убить их всех."]},{"code":101,"indent":1,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":1,"parameters":["В одиночку ты бы не смогла расправиться со всеми."]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Ты качаешь головой, тихо усмехаясь; на глаза наворачиваются слёзы. Спорить нет сил."]},{"code":101,"indent":1,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":1,"parameters":["Ну конечно. Мне следовало знать. Я уже подвела столько людей… что для меня ещё одна ошибка?"]},{"code":101,"indent":1,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":1,"parameters":["Слушай, я не хотел всё испортить—"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Это его вина"]},{"code":101,"indent":1,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":1,"parameters":["Это всё твоя вина!"]},{"code":355,"indent":1,"parameters":["SAnim(\"leon\").addAnimation(\"angry\", true, 0, 0.5)"]},{"code":101,"indent":1,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":1,"parameters":["Что?"]},{"code":101,"indent":1,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":1,"parameters":["Я собиралась убить каждого из них. У меня всё было готово. А ты всё испортил. Ты испортил всё!"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Он принимает оборонительную позу, взгляд твердеет."]},{"code":101,"indent":1,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":1,"parameters":["Эй, я не знал, что это место заминировано. В следующий раз оставь табличку."]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Ты сверлишь его взглядом."]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Уходи, чужак, пока не наделал ещё больше бед. Здесь опасно."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").addAnimation(\"normal\", true, 0, 0.5)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он прищуривается и смотрит на тебя с таким спокойствием, что твоя злость лишь сильнее разгорается."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["Не для меня. Для тебя. Ты убьёшь себя, если продолжишь в том же духе."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Прошу прощения? Это ты чуть не погиб там."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["Я обучен таким вещам. Справлюсь."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Ты не знаешь этих тварей так, как я. Они заманивают запахом."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Хочешь попасть в лабораторию прямо сейчас? Пожалуйста. Но кончишь так же, как все, кто пытался, — мёртвым."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Он замолкает, и впервые его лицо слегка смягчается, пока он изучает тебя."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["Ты не видела, чтобы здесь проходила команда?"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Здесь проходит много людей. Они идут в лабораторию, берут, что им нужно, и бросают нас на произвол судьбы."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Или идут туда и не возвращаются. Кого бы ты ни искал — они, скорее всего, мертвы. Или хуже."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Мужчина оглядывается на лес; лицо мрачнеет, становится задумчивым."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Мужчина"]},{"code":401,"indent":0,"parameters":["Мне нужно попасть в лабораторию и выяснить, что с ними случилось. Я не уйду, пока не узнаю."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты качаешь головой, не удивляясь. Конечно. Все они одинаковые."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Ты"]},{"code":401,"indent":0,"parameters":["Удачи. Она тебе понадобится."]},{"code":355,"indent":0,"parameters":["SAnim(\"leon\").fadeOut(30)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Не дожидаясь ответа, ты разворачиваешься и уходишь, не обращая внимания на боль в груди. Придётся начинать с нуля — отстраивать всё заново, снова вооружаться."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Рука находит подвеску на груди. Ты крепко сжимаешь её, чувствуя, как знакомая форма впивается в кожу."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Прости."]},{"code":232,"indent":0,"parameters":[4,0,1,0,640,270,100,100,0,0,60,true,0]},{"code":231,"indent":0,"parameters":[6,"house_inside",1,0,640,270,100,100,0,0]},{"code":232,"indent":0,"parameters":[6,0,1,0,640,270,100,100,255,0,60,true,0]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты врываешься в дом и с грохотом захлопываешь дверь."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Снаряжение выпадает из рук, но ты почти не замечаешь этого. Все мысли — о нём. О самоуверенном чужаке с непроницаемым лицом."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты стискиваешь зубы. Он погибнет. Ты знаешь это. У него даже маски нет. Стоит ему приблизиться к лаборатории — и ему конец."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Ты велела ему уходить, предупредила, что там. Если он умрёт, это будет на нём. Ты ему ничего не должна. Он разрушил твой план — последний шанс спасти остатки этого города."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Но мысль о том, что он вслепую бредёт в лабораторию, не даёт покоя. Какого чёрта тебя это волнует? Не должно."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Не волнует."]},{"code":232,"indent":0,"parameters":[6,0,1,0,640,270,100,100,0,0,120,true,0]},{"code":242,"indent":0,"parameters":[1]},{"code":121,"indent":0,"parameters":[1,1,0]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[1]},{"code":235,"indent":0,"parameters":[2]},{"code":235,"indent":0,"parameters":[3]},{"code":235,"indent":0,"parameters":[4]},{"code":235,"indent":0,"parameters":[5]},{"code":235,"indent":0,"parameters":[6]},{"code":201,"indent":0,"parameters":[0,5,6,9,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":5,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":7,"y":4},null,null,{"id":4,"name":"skin_choice","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":f